{"nodes": [{"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "label": "Global CLI installation lifecycle design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L1-L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-approved design contract for global install/update/uninstall and automatic RTK/Graphify synchronization, not itself a completion report; implementation evidence belongs to the linked plans.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_global_profile", "label": "One global installation per user profile", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L12-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All projects share one profile installation; project configuration stays separate. Preserve language, memory and personal rules with verifiable recovery. Windows/Git Bash and Linux plus RU/EN/AZ documentation are in scope, not GUI/services/accounts or Python-crash diagnosis.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_selection_criteria", "label": "Lifecycle design selection criteria", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L40-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prioritize no unexplained overwrite, backup before first mutation, one shared lock, ordinary-error and process-crash recovery, consistent CLI/script behavior and command/language/memory compatibility.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_script_wrapper_alternative", "label": "Wrapper-around-existing-scripts alternative", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L49-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected as the main design because unknown script side effects make partial writes indistinguishable from later personal edits without precomputed expected content.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_prepared_transaction", "label": "Prepared change set and shared transaction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L55-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected approach computes exact new files and permitted settings edits before snapshot and verification. Reusing the existing Python mechanism gives unified ownership/recovery while shell commands remain compatible.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_install_flow", "label": "Global install and reinstall flow", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L64-L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep no-clone terminal installation; installed conductor install uses the same global mechanism. Install missing RTK/Graphify and update existing copies unless explicitly skipped.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_update_flow", "label": "Global update and read-only check", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L69-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Update Conductor and installed RTK/Graphify even when Conductor is current; do not introduce absent tools. update --check performs no installation or other mutations.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_uninstall_flow", "label": "Global CLI and standalone uninstall equivalence", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L73-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conductor uninstall and uninstall.sh share behavior. Independent RTK, Graphify, Superpowers and project rules remain; lesson preservation/removal is explicit. status and rollback are retained.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_preparation", "label": "Validated preparation and payload rendering", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L81-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validate arguments, dependencies, readable source and link-free paths, then lock. A prepared list records prior/expected bytes and modes, components, provenance and checks; payload.py remains the sole renderer.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_language_selection", "label": "Single persisted language decision", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L83-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use explicit language, otherwise a dialog with stored choice, saved choice for noninteractive execution, then Russian default. Invalid parameters must not mutate installation.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_ownership", "label": "First-install and reinstall ownership rules", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L92-L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeat install refuses changed managed files. First explicit overwrite of personal rules requires a visible warning and verified recoverable snapshot; --skip-global-md preserves CLAUDE.md and a foreign conductor command is never overwritten.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_pending_journal", "label": "Private pending journal and lock lifetime", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L98-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store the snapshot and pending journal outside runtime before the first write, holding the common lock through verification and journal close. Atomicity is per file, not the whole tree.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_conditional_recovery", "label": "Compare-before-write and conditional recovery", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L104-L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare the earlier observation before each write and read back bytes/modes after it. Restore only own changes; later foreign changes preserve both available states and yield a backup-path error.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_version_last", "label": "Version stamp after executable verification", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L109-L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stamp the new version only after checking new installed entry points and exact hook registrations, independently of any old revision marker. Failed verification cannot claim the new version installed.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_crash_recovery", "label": "Next-command interrupted-operation recovery", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L113-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The next mutating command under the same lock restores a verified pending snapshot or refuses on conflict. rollback supports both install and update snapshots; status reports incompleteness rather than claiming health.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_legacy_settings", "label": "Owned hook parsing and legacy cleanup", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L118-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse the existing JSON hook-ownership parser, preserve foreign commands/keys, and list Cursor, Antigravity and Git edits explicitly in the plan. Known retired files require bounded ownership and snapshots; unknown or mixed directories are never wholesale-deleted.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_private_data_boundary", "label": "Private data and component preservation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L126-L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lessons, verification results, model settings, keys and targets outside the allowlist are not replacement payload. Selecting a scope does not implicitly remove other registered components.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_companion_phase", "label": "Separate companion phase after Conductor", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L130-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start companions only after the successful Conductor transaction and report outcomes independently. A failed tool neither reverses Conductor nor becomes green readiness. No Superpowers auto-update or project Graphify rebuild is requested.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_stable_sync", "label": "Latest stable RTK/Graphify synchronization", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L135-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every normal install/reinstall/update checks stable releases for existing RTK/Graphify copies; install adds missing tools and update does not. Working is not necessarily current; explicit skip/read-only check are exceptions and prereleases are excluded.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_managed_migration", "label": "Managed-copy migration of recognized uv/Cargo tools", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L144-L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user-approved clarification creates separate managed copies with verified PATH priority while preserving original programs and manager data. Instructions update only if equal to original or registered content; unknown programs and personal edits remain unclaimed.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_acceptance", "label": "Fault, ownership and platform acceptance", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L151-L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptance covers scopes/languages, special-character literal paths, no-clone and checkout-free launchers, global/standalone equivalence, memory preservation, version-service failures, write/verify/crash fault injection, concurrent operations, POSIX modes and hostile paths/state. New guards must fail when disarmed.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_completion_boundary", "label": "Completion and graph-source freshness boundary", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L175-L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Completion concerns the existing CLI risks and automatic RTK/Graphify flows, not new GUI or mandatory agent rules. Refresh Graphify once after a coherent change set; while code changes, files remain source truth.", "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_global_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L12-L27", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_selection_criteria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L40-L47", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_script_wrapper_alternative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L49-L53", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_prepared_transaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L55-L60", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_install_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-27-installation-lifecycle-design.md", "source_location": "L64-L68", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_specification", "target": "docs_superpowers_specs_2026_09_27_installation_lifecycle_design_update_flow", "relation": "references", "confidence": "EXTRACTED", "conf