{"nodes": [{"id": "docs_superpowers_plans_2026_09_27_companion_updates_plan", "label": "Companion Updates Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L1-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate inventory, acquisition and application modules feed one coordinator after verified Conductor. Python 3.10+/Bash and existing uv/venv or RTK download facilities avoid introducing another package manager.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_implementation_status", "label": "Companion delivery status and acceptance evidence", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L17-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The status paragraph records implemented managed migration, PATH recovery, isolated Windows/Linux real-version checks and commit 3ce180a. The following checklists are historical, not evidence that this extraction executed their commands.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_sync_contract", "label": "sync(paths, mode, skip) coordination contract", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L61-L70; L155-L189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install/update/check share a coordinator returning per-tool records in rtk, graphify order. It uses the caller's common lock rather than re-entering it, and CONDUCTOR_COMPANION_HOME must be absolute and canonical.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_result_statuses", "label": "Per-tool status records", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L61-L67; L165-L177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records expose tool/status/before/after/latest/detail and CURRENT, UPDATED, INSTALLED, AVAILABLE, ABSENT, SKIPPED or FAILED. Offline discovery and shadowed commands must not be reported CURRENT/UPDATED.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_install_update_check", "label": "Distinct install, update and check semantics", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L32-L42; L165-L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install adds missing tools and upgrades existing ones; update leaves absent tools absent and still synchronizes when Conductor is current; check never invokes upgrade or wire. Superpowers auto-upgrade and project map rebuilds are excluded.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_inventory", "label": "discover inventory and provenance", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L72-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inventory exposes executable/version/provider/manager/root/receipt. Official RTK provenance and graphifyy manager records, not basenames or a successful version command alone, establish ownership.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_stable_releases", "label": "Official stable release selection", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L72-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query official RTK release assets/checksums and non-yanked stable PyPI graphifyy metadata. Do not inherit a third-party package index or silently downgrade to an older release when latest is unsupported.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_provider_provenance", "label": "Provider identity and ownership boundary", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L38-L42; L72-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed receipts and verified uv/Cargo metadata distinguish recognized tools from unknown programs. crates.io rtk is a different project; unknown tools remain unchanged with a failure/skip explanation.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_managed_migration", "label": "Recognized uv/Cargo migration to managed copies", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L17-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The implemented and user-approved approach creates isolated managed copies with PATH priority and preserves original uv/Cargo tools and stores. This status supersedes the older in-place-manager checklist below.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_path_readiness", "label": "PATH priority and actual command readiness", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L44-L50; L65-L67; L165-L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exact new binary passing --version is insufficient if normal PATH resolution still selects the old tool. Readiness also requires effective command resolution and installed wiring.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_upgrade_contract", "label": "upgrade and probe contracts", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L105-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "upgrade(found, name, version, root, profile) returns a verified executable; probe checks actual launch and exact expected version. An error restores only verified own changes and then raises.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_candidate_transaction", "label": "Candidate-first companion switch", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L125-L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acquire a candidate separately, probe it, preserve the checked old copy, atomically switch the launcher and probe again. A partial candidate never becomes active, and later attempts recognize unfinished switches.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_versioned_graphify_environment", "label": "Final-path versioned Graphify environment", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L125-L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create the virtual environment directly at its final versioned path because moving a venv breaks embedded paths. Receipts and backups live outside the removable Conductor runtime.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_conditional_restore", "label": "Compare-before-restore for companion state", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L114-L121; L134-L141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshot exact executables, environment and manager metadata before writes; reject links and unknown targets. Later manager/personal changes cause conflict rather than restoration over another writer.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_historical_manager_upgrade", "label": "Historical in-place external-manager upgrade design", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L131-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original checklist proposed exact uv tool reinstall within the same store and official Cargo git refs, with consistent manager metadata. L17-L27 now records separate managed-copy migration instead; do not interpret this historical alternative as current behavior.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_uv_pin_trap", "label": "Pinned uv upgrade false-success trap", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L44-L50; L116-L122; L136-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A manager exit code 0 with the old pinned version is not latest-version success. Tests must verify executable version and manager metadata rather than receipt existence.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_independent_interpreter", "label": "Independent interpreter before replacing Graphify", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L142-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The historical manager-update design checks whether updater Python is running from the target environment and re-executes independently before locking or writing. Without an independent interpreter it fails safely; no new Python/Node is silently installed.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_wire_contract", "label": "wire executable and owned configuration", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L161-L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wire only a verified executable using isolated HOME/USERPROFILE/config during checks, compare owned records and preserve foreign hooks/settings. Existing Graphify skill content is checked, not merely its presence.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_skill_ownership", "label": "Graphify skill ownership and preservation", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L46-L50; L165-L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Package/original registered content can be refreshed; personally edited skill files are preserved with a conflict and FAILED readiness. MCP/project hooks remain out of scope.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_partial_failure", "label": "Partial companion failure without Conductor rollback", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L35-L42; L175-L189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each tool has an independent outcome. FAILED yields partial code 3 while preserving already verified Conductor; the shell wrapper and global lifecycle coordinator use the same contract.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_superpowers_boundary", "label": "Superpowers installation-only compatibility", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L35-L42; L184-L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing Superpowers installation/enabling behavior stays in the shell entry point; this plan does not add automatic Superpowers upgrades and preserves --skip-companions.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_acceptance", "label": "Companion negative tests and real executable acceptance", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L116-L124; L148-L153; L165-L189; L191-L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests cover old-tool recovery, pinned versions, later edits, running interpreter, metadata, changed skills, PATH shadowing and independent outcomes. Windows needs a real native executable, and guards are falsified in isolated current copies.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_review_focus", "label": "Companion review focus", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L44-L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prioritize PATH shadowing, pinned uv upgrades, replacing the active Graphify interpreter, unusable latest releases and personally edited skills; each needs a negative test.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_uv_tools_documentation", "label": "uv tools upgrade documentation", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L198-L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited primary guide: https://docs.astral.sh/uv/guides/tools/; check current version constraints during implementation.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_uv_cli_documentation", "label": "uv CLI reference", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited primary reference: https://docs.astral.sh/uv/reference/cli/.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_official_rtk", "label": "Official rtk-ai/rtk project", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited official upstream: https://github.com/rtk-ai/rtk; distinct from crates.io RustTypeKit.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_companion_updates_official_graphify", "label": "Official Graphify upstream", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L200-L201", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited upstream: https://github.com/Graphify-Labs/graphify; upgrade and skill reinstall require fresh version/compatibility checks.", "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_plans_2026_09_27_companion_updates_plan", "target": "docs_superpowers_plans_2026_09_27_companion_updates_implementation_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-27-companion-updates.md", "source_location": "L17-L30", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_27_companion_updates_plan", "target": "do