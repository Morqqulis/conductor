{"nodes": [{"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "label": "Global CLI Lifecycle Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L1-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend existing Paths, UpdatePlan and Transaction so shell entry points share global install/update/uninstall and recoverable changes. Companions synchronize after Conductor under a separate coordinated plan.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_implementation_status", "label": "Lifecycle implementation and evidence status", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L17-L24; L211-L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opening status records tasks 1-4 implemented, commit 3ce180a, checked live Russian install and local Windows/Linux results. The historical closing checklist still says the live install had not changed; this stale statement must not silently override current status.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_global_scope", "label": "One profile-wide lifecycle", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L26-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One profile installation serves every project on Windows/Git Bash and Linux. Personal lessons, evidence, model settings, working Git, project rules and independent tools are not replacement payload. No GUI, service, database or Python-crash investigation is added.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_paths_updateplan_transaction", "label": "Paths, UpdatePlan and Transaction architecture", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L8-L10; L48-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse the existing path targets, prepared change plan and transaction snapshot format. installation/removal prepare operations, cli coordinates them, recovery handles pending work and payload remains the single renderer.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_compatibility_entrypoints", "label": "Compatible shell and helper entry points", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L48-L55; L94-L104; L136-L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "install.sh, install-global.sh, uninstall.sh and install preflight/receipt/CLI helpers delegate to the same mechanism rather than maintaining a second write algorithm.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_common_journal", "label": "Common pending journal and recovery", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L57-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before writes, create the snapshot then an atomic pending record in private state; verify payload, write state last and clear pending only after confirmation. Existing schema-1 snapshots remain valid for rollback.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_recovery_contract", "label": "pending and recover contracts", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L63-L66; L81-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pending validates and reports without writes; recover is invoked only inside exclusive(paths), uses a verified own-installation snapshot and accepts only recorded before/after states.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_conditional_bytes_modes", "label": "Conditional byte and mode recovery", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L42-L43; L71-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recovery checks bytes and POSIX modes including readback. Mode-only edits after interruption are conflicts; both available states are preserved rather than overwritten.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_source_based_recovery", "label": "Installer recovery without partial runtime imports", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L68-L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A killed child and a fresh complete-source installer prove recovery does not import a half-removed runtime. Fault injection is test-only, not a production bypass.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_installation_contract", "label": "prepare_install, verify and apply_install contracts", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L92-L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prepare_install accepts source, scopes, reply, skip_values and revision and returns UpdatePlan; verify uses the supplied new scopes, while the existing prepare update contract remains.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_scope_language_merge", "label": "Preserved scopes and single language choice", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L106-L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render all files before writing; choose language once, merge selected scopes with registered components and keep --skip-global-md. First personal-rule overwrite warns and snapshots; subsequent manual edits cause refusal.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_settings_ownership", "label": "Owned JSON hook leaves", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L55; L118-L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse settings-json install/strip ownership parsing. Malformed or duplicate-key JSON is rejected and foreign hooks/settings remain intact; Cursor and Antigravity changes are explicit transaction targets.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_legacy_cleanup", "label": "Full-content legacy cleanup and exact Git origin", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L124-L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retired files may be removed only by complete known content after snapshot. Git config changes require the actual global origin within the profile and exact old Conductor value; unknown origins or mixed templates are retained with a warning.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_bootstrap_revision", "label": "Bootstrap revision inside the shared operation", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L110-L115; L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bootstrap supplies its verified source SHA to the common operation, not a receipt written outside the lock. Dirty local source has no claimed clean revision.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_removal_contract", "label": "prepare_removal and apply_removal contracts", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L136-L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLI and standalone removal share the plan and apply contract. Lessons are kept by default; explicit --remove-lessons requests their removal and --keep-lessons remains compatible.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_removal_ownership", "label": "Conservative removal ownership", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L148-L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only positively identified owned files are removed under the same snapshot/lock. Unknown leftovers and ambiguous manifestless state cause preservation/refusal; personal global CLAUDE.md is never removed.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_project_sweep", "label": "Opt-in project sweep outside global transaction", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L162-L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standalone --sweep-roots remains explicit and uses checked project-artifacts ownership. It is not one atomic transaction spanning all projects and the global installation.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_windows_self_removal", "label": "Windows conductor.cmd self-removal and exit status", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L45; L148-L151; L164-L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test the installed .cmd, not just cli.py. Deleting a batch file must not cause its continuation or lose the actual exit code; restoration uses a complete source copy after the CLI is removed.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_post_uninstall_restore", "label": "Source-based restoration after uninstall", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L164-L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Print the concrete Python cli.py --config --profile rollback --backup command with real paths. Do not promise that the now-removed conductor command can restore itself.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_companion_coordination", "label": "Lifecycle companion synchronization", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L173-L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use companions.sync for install/update/check even when Conductor SHA is current; a companion failure preserves verified Conductor. One caller-held lock spans both phases without nested acquisition, and status/check only report pending.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_exit_contract", "label": "Global lifecycle exit-code contract", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L179-L184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0 confirms the entire requested flow, 1 means Conductor error, 2 invalid arguments, 3 verified Conductor but incomplete companions, and 130 interruption. Explicit skip or absent tools during update are not failures.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_acceptance", "label": "Windows/Linux lifecycle acceptance", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L106-L117; L130-L134; L148-L170; L195-L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exercise installed launchers and no-clone install/update/uninstall in isolated profiles, preserve private data and literal special-character paths, cover fault points and platform skips, and separate fake transport from real network checks.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_delivery_boundary", "label": "Coherent delivery, documentation and graph freshness", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L173-L177; L201-L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Update RU/EN/AZ README, HANDOFF and CHANGELOG before one final Graphify update. Match staged changes to proof; publishing and GitHub CI have distinct status, and successful extraction alone is not published-graph verification.", "_origin": "semantic"}, {"id": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_review_focus", "label": "Lifecycle review focus", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L40-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Review interruption after file verification, mode-only late edits, global targets without checkout, Windows self-removal exit status and conservative behavior for missing state or mixed directories.", "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "target": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_implementation_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L17-L24; L211-L212", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "target": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_global_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L26-L38", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "target": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_paths_updateplan_transaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L8-L10; L48-L55", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "target": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_compatibility_entrypoints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-09-27-global-cli-lifecycle.md", "source_location": "L48-L55; L94-L104; L136-L146", "weight": 1, "_origin": "semantic"}, {"source": "docs_superpowers_plans_2026_09_27_global_cli_lifecycle_plan", "target": "docs_s