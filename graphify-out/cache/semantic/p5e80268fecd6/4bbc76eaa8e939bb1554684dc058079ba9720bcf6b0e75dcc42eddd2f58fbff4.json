{"nodes": [{"id": "docs_superpowers_plans_2026_07_09_portability", "label": "docs/superpowers/plans/2026-07-09-portability.md", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_07_09_portability", "label": "Conductor Portability Plan (multi-harness)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "portability_plan_l1_instruction_text", "label": "L1 \u2014 instruction text layer", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapters carry a digest (iron laws + completion gate + marker protocol), not the full playbooks, until per-model reps justify more."}, {"id": "portability_plan_l2_harness_hooks", "label": "L2 \u2014 harness hooks layer", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "portability_plan_l3_git_native_gate", "label": "L3 \u2014 git-native gate layer", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harness-agnostic, enforced by git itself for any agent or human \u2014 the only layer that covers all tools at once."}, {"id": "portability_plan_marker_protocol_v2", "label": "Marker protocol v2 (check/consume split)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pre-commit checks the single-use marker, post-commit consumes it, so attempts that die later keep the marker alive for retry; rejected alternatives (harness-side consumption, pre-commit-side consumption) caused false denials or false burns verified live in review."}, {"id": "portability_plan_phase1_git_gate", "label": "Phase 1 \u2014 git-native commit gate", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "portability_plan_phase2_cursor_adapter", "label": "Phase 2 \u2014 Cursor adapter", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "failClosed stays FALSE because beforeShellExecution fires on every terminal command; a crashed gate under failClosed would brick the whole terminal, violating 'a broken gate must not brick git'. No sessionStart hook added since alwaysApply already injects the digest every session."}, {"id": "portability_plan_phase3_antigravity_adapter", "label": "Phase 3 \u2014 Antigravity desktop adapter", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook reply schema pinned by binary forensics of agy.exe rather than blog posts, since protobuf JSON parsing may reject unknown fields."}, {"id": "portability_plan_phase4_gemini_surfaces", "label": "Phase 4 \u2014 Gemini surfaces", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "portability_plan_global_rollout", "label": "Global rollout (2026-07-10)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git-native layer stays per-repository by design: a global core.hooksPath would silently disable every repo's own hooks (husky and ours alike)."}, {"id": "portability_plan_zero_friction_enforcement", "label": "Zero-friction enforcement + full methodology", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User feedback that all projects are production and per-repo PowerShell runs are unacceptable friction; goal reframed to the methodology everywhere, not just the commit gate."}, {"id": "portability_plan_ensure_gitgate", "label": "Ensure-GitGate self-install mechanism", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs post-commit BEFORE pre-commit so a partial install never enables the check without its marker consumer; fast path requires the sentinel in both hooks so a deleted post-commit heals on next contact."}, {"id": "portability_plan_methodology_pack", "label": "Methodology pack (four portable playbooks)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "portability_plan_install_gateinto_bug", "label": "Install-GateInto boolean-return bug", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write-Output lines polluted the function's boolean return via PowerShell's output stream, so skip/fail paths reported success and the sweep count lied; fixed with Write-Host and re-verified."}, {"id": "docs_superpowers_plans_2026_07_09_portability", "label": "2026-07-09-portability.md plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_09_portability", "target": "portability_plan_l1_instruction_text", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_plans_2026_07_09_portability", "target": "portability_plan_l2_harness_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_plans_2026_07_09_portability", "target": "portability_plan_l3_git_native_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_plans_2026_07_09_portability", "target": "portability_plan_phase1_git_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_plans_2026_07_09_portability", "target": "portability_plan_phase2_cursor_adapter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/supe