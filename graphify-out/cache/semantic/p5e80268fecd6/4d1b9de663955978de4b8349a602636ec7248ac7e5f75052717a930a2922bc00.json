{"nodes": [{"id": "adapters_antigravity_conductor_core", "label": "Conductor Core (Antigravity adapter)", "file_type": "document", "source_file": "adapters/antigravity/conductor-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adapters_antigravity_conductor_core_iron_laws", "label": "Iron Laws", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Iron laws", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as capability denials rather than advice so only explicit in-conversation user approval, never standing instructions or inferred urgency, can lift them."}, {"id": "adapters_antigravity_conductor_core_before_acting", "label": "Before Acting Classification", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Before acting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adapters_antigravity_conductor_core_completion_gate", "label": "Completion Gate", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Completion gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes required evidence to the impact of the change so trivial edits are not forced through a full test/build/browser cycle while behavior-changing edits are."}, {"id": "adapters_antigravity_conductor_core_debugging", "label": "Debugging Playbook", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Debugging", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires reproducing the failure and ranking at least two candidate causes before any fix edit, so the first idea is treated as a candidate rather than an assumed diagnosis."}, {"id": "adapters_antigravity_conductor_core_investigating", "label": "Investigating Playbook", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Investigating", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enumerates candidates and requires reading actual files because framework priors are not treated as evidence."}, {"id": "adapters_antigravity_conductor_core_unverified_label", "label": "Unverified Label Rule", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Unverified label", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any factual claim not backed by evidence inspected in the current session must be marked unverified, since memory should never speak as fact."}, {"id": "adapters_antigravity_conductor_core_implementing", "label": "Implementing Playbook", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Implementing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adapters_antigravity_conductor_core_safe_undo", "label": "Safe Undo Procedure", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Implementing, item 6 (SAFE UNDO)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires naming exact pre-task snapshots before the first write and reversing only one's own hunks, because a blanket stash/reset/clean can hide user or test hunks."}, {"id": "adapters_antigravity_conductor_core_cleanup_sweep", "label": "Cleanup Sweep", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Implementing, item 7 (CLEANUP SWEEP)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting or renaming something without resolving its orphaned wiring (registrations, caches, migrations, env vars, docs) is treated as only half a deletion."}, {"id": "adapters_antigravity_conductor_core_scope_restraint", "label": "Scope Restraint", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Scope restraint", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A request is treated as a contract, not a starting point, to prevent unrequested features, refactors or silent scope change."}, {"id": "adapters_antigravity_conductor_core_long_runs", "label": "Long Runs Discipline", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Long runs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never end a turn on a plan or promise; remaining context is not itself a reason to stop, since only irreversible actions, real scope changes, or user-only input justify pausing."}, {"id": "adapters_antigravity_conductor_core_delegation", "label": "Delegation Rule", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Delegation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegates only subtasks that are both independent and sizeable, since a small task costs a full context setup for a subagent but buys nothing back, and a separate verifier is reserved for work not watched being done."}, {"id": "adapters_antigravity_conductor_core_self_skepticism", "label": "Self-Skepticism Check", "file_type": "concept", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "## Self-skepticism", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claim preconditions are separated into PROVEN versus ASSUMED because the writer's own report 