epeat", "label": "Reuse Rather Than Repeat", "file_type": "concept", "source_file": "runtime/playbooks/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A remembered green run or an agent's summary is treated as insufficient evidence because inputs (source, deps, config, environment) may have silently changed since the result was produced."}, {"id": "runtime_playbooks_verification_when_execution_is_needed", "label": "When Execution Is Needed", "file_type": "concept", "source_file": "runtime/playbooks/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_verification_acceptance_and_reporting", "label": "Acceptance and Reporting", "file_type": "concept", "source_file": "runtime/playbooks/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence must be matched to staged content rather than the working tree or commit hash, because staged and working-tree state can diverge before a commit."}], "edges": [{"source": "runtime_playbooks_verification", "target": "runtime_playbooks_verification_choose_from_observed_impact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/verification.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_verification", "target": "runtime_playbooks_verification_reuse_rather_than_repeat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/verification.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_verification", "target": "runtime_playbooks_verification_when_execution_is_needed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/verification.m