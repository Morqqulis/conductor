{"nodes": [{"id": "runtime_playbooks_orchestration", "label": "runtime/playbooks/orchestration.md", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration_orchestration", "label": "runtime/playbooks/orchestration.md", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration", "label": "runtime/playbooks/orchestration.md", "file_type": "code", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatch prompts use a closed slot whitelist instead of inherited history because 'context is rent \u2014 everything pasted is re-read every turn'"}, {"id": "runtime_playbooks_orchestration", "label": "playbooks/orchestration.md", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration", "label": "Orchestration Playbook", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration_playbook", "label": "Orchestration Playbook", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration_cost_model", "label": "Cost Model", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Cost model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegation is meant to reduce main-session context on large independent scopes, not to multiply many small tasks \u2014 this is why the rules below generalize."}, {"id": "runtime_playbooks_orchestration_when", "label": "WHEN (dispatch thresholds)", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thresholds are machine proxies, never judgment: doubt about subtask independence resolves toward dispatch, and a small subtask is never delegated because setup cost exceeds the benefit."}, {"id": "runtime_playbooks_orchestration_async", "label": "ASYNC (controller does not idle)", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "ASYNC", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration_fleet", "label": "FLEET (size and shape)", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "FLEET", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fleet size is derived from structure (independent angles x verification votes), never a favorite number; unknown-size discovery loops until a full extra round finds nothing new because fixed counters undercount the tail."}, {"id": "runtime_playbooks_orchestration_how_context", "label": "HOW \u2014 Constructed Context (closed slot whitelist)", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dispatch prompt never inherits history \u2014 only the six named slots \u2014 so the agent's scope and evidence contract are fully explicit and auditable."}, {"id": "runtime_playbooks_orchestration_model_effort", "label": "Model and Effort per Dispatch", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "MODEL AND EFFORT", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A verifier never runs lighter than the audited work, and lighter models are used only for mechanical, machine-checkable stages, to avoid weakening the check the dispatch exists to provide."}, {"id": "runtime_playbooks_orchestration_parallel_mutation", "label": "Parallel Mutation Rules", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "PARALLEL MUTATION", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-tree gates are excluded from parallel dispatch prompts because a neighbour's half-done state would fail them outside the agent's control; acceptance diffs the agent's changes against its declared area before trusting its report."}, {"id": "runtime_playbooks_orchestration_routing", "label": "Routing by Returned Status", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Routing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The report itself is never accepted as evidence; DONE is verified by inspecting the diff or running the check, and BLOCKED is never re-dispatched with the same prompt."}, {"id": "runtime_playbooks_orchestration_integration", "label": "Integration (post-dispatch)", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Integration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file named by two or more agents from different angles is a coupling hotspot and must be read directly, because a fresh-context verifier catches what a report conceals \u2014 rigor peaks at integration, not at dispatch."}, {"id": "runtime_playbooks_orchestration_degradation", "label": "Orchestration \u2014 Degradation", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Degradation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_orchestration", "label": "Orchestration Playbook", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "runtime_playbooks_orchestration_playbook", "target": "runtime_playbooks_orchestration_cost_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_orchestration_playbook", "target": "runtime_playbooks_orchestration_when", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_orchestration_playbook", "target": "runtime_playbooks_orchestration_async", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_orchestration_playbook", "target": "runtime_playbooks_orchestration_fleet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_orchestration_playbook", "target": "runtime_playbooks_orchestration_how_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file":