{"nodes": [{"id": "runtime_playbooks_skeptic", "label": "runtime/playbooks/skeptic.md", "file_type": "document", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_skeptic", "label": "runtime/playbooks/skeptic.md", "file_type": "code", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementer claims are re-typed as UNVERIFIED CLAIMS for the verifier so that rationales can never be used to downgrade a finding's severity"}, {"id": "runtime_playbooks_skeptic", "label": "Skeptic Playbook", "file_type": "document", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_skeptic", "label": "Skeptic Playbook (external reference)", "file_type": "document", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_skeptic", "label": "Skeptic Playbook", "file_type": "document", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skeptic exists for the gap between a REPORT and the artifact behind it \u2014 the one place a self-check cannot reach; re-checking your own already-verified edit is not its job."}, {"id": "runtime_playbooks_skeptic_invocation", "label": "Skeptic Invocation Rule", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_skeptic_cross_model_variant", "label": "Cross-Model Verifier Variant", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A verifier from a different model family does not share this model's blind spots, so it is used as a depth move when a crossmodel.conf is configured."}, {"id": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "label": "Verifier Dispatch Prompt Template", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_skeptic_resolution_rules", "label": "Skeptic Resolution Rules", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unverifiable claim that cannot be checked by any means is treated as not DONE, to prevent laundering unverifiable claims into completion status (core anti-laundering rule)."}, {"id": "runtime_playbooks_skeptic_inline_mode", "label": "Skeptic Inline Mode", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifying in the same message that implemented the change would let the same blind spots that produced the code also approve it, so verification is forced into a separate message."}, {"id": "runtime_playbooks_skeptic_inversion_pass", "label": "Inversion Pass", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listing preconditions and tagging each PROVEN or ASSUMED converts confidence into a checkable list, exposing the usual place a plausible claim is actually wrong."}, {"id": "runtime_playbooks_skeptic_guards_prose", "label": "A Guard's Prose Is a Claim, Not Evidence", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What a guard says about itself is untested text; only probing each claim (compiling probes, grepping invocation, checking compiled scope) turns the description into evidence."}, {"id": "runtime_playbooks_skeptic_rigor_gradient", "label": "Rigor Gradient", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "code_review_skill", "label": "/code-review Skill", "file_type": "concept", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "runtime_playbooks_skeptic", "target": "runtime_playbooks_skeptic_invocation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_skeptic", "target": "runtime_playbooks_skeptic_cross_model_variant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_skeptic", "target": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "weight": 1}, {"source": "runtime_playbooks_skeptic", "target": "runtime_playbooks_skeptic_resolution_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file"