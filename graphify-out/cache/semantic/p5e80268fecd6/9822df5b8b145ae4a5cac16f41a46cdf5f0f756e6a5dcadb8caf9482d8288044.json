e": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_subagent_start_hook", "label": "SubagentStart hook", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_core_md", "label": "core.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_subagent_contract_md", "label": "subagent-contract.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_debugging_md", "label": "playbooks/debugging.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attempt pre-registration requires a todo entry 'attempt N: hypothesis H' created before the edit and closed by a verification run, so a failed run cannot be relabeled 'refined previous attempt' instead of a failed attempt (panel fix C5)."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_implementing_md", "label": "playbooks/implementing.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_investigating_md", "label": "playbooks/investigating.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds an enumeration artifact first so the candidate list's length is an objective, mechanical branch input for whether to fan out, rather than a subjective judgment call (panel fix C6)."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_orchestration_md", "label": "playbooks/orchestration.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States a cost model ('context is rent \u2014 everything pasted is re-read every turn') so the caps on subagent returns and constructed-context slots generalize rather than being arbitrary limits."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_skeptic_md", "label": "playbooks/skeptic.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_probes_md", "label": "snippets/probes.md", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_iron_laws", "label": "Iron Laws (3 absolute rules)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An override is defined narrowly as an explicit user message in the current conversation addressing this specific task; standing instructions, CLAUDE.md content, config files, and inferred urgency never qualify (panel fix C7), so the escape valve cannot be exploited implicitly."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_step0_protocol", "label": "First-action protocol (Step 0)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_classification_table", "label": "Classification table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-match priority is debug > review > implement > investigate because process-failure symptoms outrank surface verbs (e.g. 'add validation so it stops crashing' counts as debug, not implement)."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_risk_tiers", "label": "Risk tiers (T1/T2/T3)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projections only set the starting tier; re-tiering is bound to observable moments (6th file touched, LOC threshold crossed, caller probe result, irreversible op surfacing) so the tier reflects accumulated facts rather than an initial guess (panel fix C2)."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_completion_gate", "label": "Completion gate", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing or failed verification is never classified as a 'concern' \u2014 it forces BLOCKED or NEEDS_CONTEXT \u2014 to prevent DONE_WITH_CONCERNS from laundering absent proof into a completion claim (panel fix C3)."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_rationalization_table", "label": "Rationalization table + pressure inoculation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_module_manifest", "label": "Module manifest", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manifest lines carry trigger conditions and temptation symptoms only, with zero procedure, per the trigger-engineering law \u2014 procedure lives solely in the referenced playbook to avoid duplication and drift."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_compaction_rules", "label": "Compaction and degradation rules", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_code_review_skill", "label": "/code-review skill (harness-native)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_success_criteria", "label": "Success criteria (S1-S7)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_benchmark", "label": "Fixed benchmark (headless A/B evaluation vs. no-conductor baseline)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baseline and A/B runs both use the reconciled CLAUDE.md so the 'double-mandate' confound (old CLAUDE.md process rules coexisting with Conductor) is absent from measurements."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_lint_budgets", "label": "Budget lint checks (character/token budgets, dead wiring, placeholder blacklist)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_claude_md_reconciliation", "label": "CLAUDE.md Reconciliation (\u00a77)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md holds values/constraints/presentation only; process, escalation and verification move into Conductor so the two never compete for authority"}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_rollout_plan", "label": "Rollout Plan (\u00a78)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_qa_plan", "label": "QA Plan (\u00a79)", "file_type": "document", "source_file": "docs/superp