{"nodes": [{"id": "readme_az_conductor", "label": "Conductor (Discipline System for AI Agents)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces any AI to follow an engineering methodology: classify the task before starting, prove the result before claiming done and before every commit, and learn from its own mistakes via persisted lessons."}, {"id": "readme_az_methodology_layer", "label": "Methodology Layer (core + playbooks + method dispatcher)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The nature of the task selects the approach (control group, instrumentation, variant jury), so the core carries iron laws plus a result gate with outcome prediction."}, {"id": "readme_az_change_scoped_verification", "label": "Change-Scoped Verification", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification volume depends on the change, not on the commit: a label edit only needs a diff inspection, while changed behaviour requires checking affected scenarios; matching earlier results are reused."}, {"id": "readme_az_memory_layer", "label": "Lesson Memory (inbox + curated)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two stores \u2014 a one-line-per-lesson inbox every AI on the machine appends to, and a curated per-file repository with an index \u2014 so retrieval is task-relevant; novelty is only a tie-breaker criterion."}, {"id": "readme_az_values_file_requirement", "label": "Mandatory Global Values File", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The A/B measurement showed the disciplined behaviour came from the values file text, not from the bare model; removing duplicated rules from Conductor and then deleting the file would silently erase all discipline with no error from installer or linter, so uninstall.sh deliberately never deletes it."}, {"id": "deploy_global_claude", "label": "deploy/global-CLAUDE.md (global values file)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "qa_reports_baseline_values_file", "label": "qa/reports/baseline-values-file.md", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "qa_reports_baseline", "label": "qa/reports/baseline.md", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "qa_reports_ab_report_v2", "label": "qa/reports/ab-report-v2.md (2026-08-15 A/B repeat)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeats the measurement on the full English installed file with the current model generation, because the first measurement (2026-07) used only a shortened 56-line Russian copy."}, {"id": "install", "label": "install.sh (Claude Code installer)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "install_global", "label": "install-global.sh (Cursor + Antigravity + Codex)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrites ~/.gemini/AGENTS.md and ~/.codex/AGENTS.md, keeping any prior text in a timestamped .bak copy and warning loudly about it."}, {"id": "install_project", "label": "install-project.sh (project-scoped adapters)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Places adapters inside a specific project so rules get versioned together with that project; applies the stored language silently."}, {"id": "install_companions", "label": "install-companions.sh (companion tools step 4/5)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every failure is reported loudly as SKIP or FAIL with its reason and never aborts the Conductor installation; re-runs are safe."}, {"id": "uninstall", "label": "uninstall.sh (removal with preview)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backs up every config it touches, recognises its own hooks by sentinels so foreign hooks survive, never deletes the global CLAUDE.md, and leaves the three companion tools alone because they are user-level and live their own lives."}, {"id": "tools_doctor", "label": "tools/doctor.sh (installation health check)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "tools_build_digests", "label": "tools/build-digests.sh (digest builder)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "tools_restore_memory", "label": "tools/restore-memory.py (memory restore)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source code and private memory live in separate repositories, so memory must be restored into a new or empty folder before installing Conductor; a non-empty destination is never overwritten."}, {"id": "tools_schedule_memory_backup", "label": "tools/schedule-memory-backup.ps1 (Windows backup schedule)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offers a preview and never replaces an existing scheduled task."}, {"id": "tools_journal_report", "label": "tools/journal-report.sh (test-run journal reader)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "conductor_evidence_cli", "label": "conductor/evidence/cli.py (verification evidence store)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores the real execution, its output and the state of declared inputs so results can be reused; check never re-executes and MATCH only means observed conditions agree, not a fresh passing test. Histories are kept per project, clone and working copy, and storage sits outside the project."}, {"id": "conductor_evidence_verification_spec", "label": "verification.json run description (schema_version 1)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent must declare every relevant dependency, setting and environment key because the tool does not detect them itself; unknown external state is declared as unknown."}, {"id": "memory_recall", "label": "memory/recall.py + recall.md (task-relevant lesson retrieval)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At session start only memory addresses are given, not the latest entries; once the task is known the agent queries by terms. Lexical candidates are found, but meaning and applicability are checked by the agent. Read errors or exceeding the limit return PARTIAL rather than a successful empty result, and memory is never mutated \u2014 no new database, service or migration is required."}, {"id": "memory_migrate_lessons", "label": "memory/migrate-lessons.sh (lesson migration)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed next to the runtime so lesson upkeep needs no copy of the source code."}, {"id": "runtime_playbooks_distill", "label": "runtime/playbooks/distill.md (lesson distillation rule)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "runtime_playbooks_verification", "label": "runtime/playbooks/verification.md (verification scope rules)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_az_commit_discipline", "label": "Commit Discipline", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is a textual rule, not a mechanical lock: the old marker git gate was removed because field data showed agents already ran evidence procedures, while the lock only demanded an extra marker file that added nothing and broke commits when forgotten. Full suites and builds run on change impact or explicit project requirement, not automatically before every commit and push."}, {"id": "readme_az_reply_language", "label": "Reply Language Selection", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules are written entirely in English on purpose, because the model thinks in the language its instructions are written in and a Russian rule corpus pulled visible thinking into Russian even when another reply language was chosen; the choice is persisted in ~/.claude/conductor/reply-language so re-runs reset nothing."}, {"id": "readme_az_language_token_lint", "label": "Language Token Substitution ('Answer in Russian')", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The language lives as one phrase that installers substitute on copy; editing it by hand in repository reference files breaks the phrase-based substitution so --language stops switching the language, and the lint therefore requires the token."}, {"id": "qa_lint", "label": "qa/lint.sh (budget, wiring and phrasing linter)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "qa_lint_selftest", "label": "qa/lint-selftest.sh (negative self-test of the linter)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "qa_settings_json_test", "label": "qa/settings-json-test.py (config editing tests)", "file_type": "code", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adapters_core_body", "label": "adapters/core-body.md (shared rule text)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cursor and Antigravity digests are assembled from it and are never hand-edited; changes are made only in runtime/ and this file because the repository is the source of truth and live copies are always rebuilt from it."}, {"id": "readme_az_conductor_cli", "label": "conductor CLI (status / update / rollback)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updates download the official main branch into a separate temporary folder so the working repository is untouched; only registered components are updated, a hand-modified managed file stops the update instead of being force-overwritten, and a backup is written before any write so a failed check restores the previous files."}, {"id": "readme_az_update_backup", "label": "Update Backups (~/.local/state/conductor/updates/)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backups hold previous rules and can be private, so they must not be shared and are not auto-deleted when Conductor is removed; later private edits stop a rollback rather than being discarded. The update is not one atomic replacement of all files, so the plain installer must not run concurrently and parallel update/rollback commands are blocked."}, {"id": "readme_az_superpowers", "label": "superpowers (Claude Code workflow-skills plugin)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The installer used to disable it; the policy is now the opposite because Conductor is the process backbone and superpowers supplies skills on top of it."}, {"id": "readme_az_rtk", "label": "rtk (Rust terminal-output compressor)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed via cargo when available; otherwise the installer prints a loud SKIP and suggests a release binary. Its own `rtk init -g` wires the Claude Code hook and ~/.claude/RTK.md, so the installer lets rtk do the wiring."}, {"id": "readme_az_graphify", "label": "graphify (codebase knowledge-graph tool)", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed as the `graphifyy` package though the command is `graphify`, with pip as fallback; `graphify install` registers the /graphify skill only if it is not registered yet."}, {"id": "readme_az_repo_structure", "label": "Repository Structure and Source of Truth", "file_type": "concept", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "runtime/ is the truth source and qa/ never reaches the runtime tree, so edits go to runtime/ and adapters/core-body.md and are then rebuilt and linted before installing."}, {"id": "docs_memory_recovery", "label": "docs/memory-recovery.md (memory restore procedure)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme", "label": "README.md (Russian)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_en", "label": "README.en.md (English)", "file_type": "document", "source_file": "README.az.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "readme_az_conductor", "target": "readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_conductor", "target": "readme_en", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_conductor", "target": "readme_az_methodology_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_conductor", "target": "readme_az_change_scoped_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_conductor", "target": "readme_az_memory_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_conductor", "target": "readme_az_values_file_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_values_file_requirement", "target": "deploy_global_claude", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.az.md", "source_location": null, "weight": 1}, {"source": "readme_az_values_file_requirement", "target": "qa_reports_baseline_values_file", "relation": "cites