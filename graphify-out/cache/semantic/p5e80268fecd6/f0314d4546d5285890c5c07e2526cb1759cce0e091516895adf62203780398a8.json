{"nodes": [{"id": "docs_archive_claude_pre_conductor_document", "label": "CLAUDE Pre-Conductor Archive (Operating Guide)", "file_type": "document", "source_file": "docs/archive/CLAUDE.pre-conductor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d \u0434\u043b\u044f \u0430\u0443\u0434\u0438\u0442\u0430: \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a\u0438\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043d\u044b\u0435 \u0441\u0435\u043a\u0446\u0438\u0438 (\u00a71\u2013\u00a74, \u00a75-part, \u00a77, \u00a79\u2013\u00a711, \u00a714) \u043c\u0438\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0432 Conductor \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u043f\u0435\u043a\u0435 conductor-design \u00a77; \u0441\u043f\u0435\u043a\u0430 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u0430 \u0438 \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f."}, {"id": "docs_archive_claude_pre_conductor_production_first", "label": "\u00a70 Production-First", "file_type": "document", "source_file": "docs/archive/CLAUDE.pre-conductor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0423\u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0430\u043a \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0435 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 (\u043c\u0435\u043d\u044c\u0448\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0439, \u043c\u0435\u043d\u044c\u0448\u0435 \u0441\u043b\u043e\u0451\u0432), \u043d\u0435 \u043a\u0430\u043a \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0434\u0451\u0436\u043d