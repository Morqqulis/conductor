 "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_proof_loop_seven_rules", "label": "\u0421\u0435\u043c\u044c \u043f\u0440\u0430\u0432\u0438\u043b", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_proof_loop_rule1_green_without_proof", "label": "\u041f\u0440\u0430\u0432\u0438\u043b\u043e 1: \u0437\u0435\u043b\u0451\u043d\u044b\u0439 \u0431\u0435\u0437 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 = \u043a\u0440\u0430\u0441\u043d\u044b\u0439", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": "\u00a73 \u041f\u0440\u0430\u0432\u0438\u043b\u043e 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_proof_loop_rule2_remove_only", "label": "\u041f\u0440\u0430\u0432\u0438\u043b\u043e 2: \u043e\u043f\u0440\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u043a \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0448\u0430\u0433 (remove-only)", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": "\u00a73 \u041f\u0440\u0430\u0432\u0438\u043b\u043e 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0411\u0435\u0437 \u043f\u0430\u0440\u044b \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u0449\u0438\u0442\u044b \u0438 \u0435\u0451 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043d\u0435\u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430: \u043e\u043d\u0430 \u043c\u043e\u0433\u043b\u0430 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u043f\