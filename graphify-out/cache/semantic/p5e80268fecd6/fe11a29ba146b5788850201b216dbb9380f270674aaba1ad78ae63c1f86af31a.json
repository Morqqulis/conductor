1 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c \u0438\u043c\u0435\u043d\u0435\u043c \u0434\u0430\u044e\u0442 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0438\u043b\u0438 \u0442\u0438\u0445\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u0441 \u0447\u0443\u0436\u0438\u043c\u0438 \u0434\u0430\u043d\u043d\u044b\u043c\u0438; \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u2014 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0438\u043c\u0451\u043d \u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u0438 \u0443\u0431\u043e\u0440\u043a\u0430 \u0437\u0430 \u0441\u043e\u0431\u043e\u0439 \u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u043c\u0438 \u043d\u0443\u043b\u0435\u0432\u044b\u043c\u0438 \u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0430\u043c\u0438."}, {"id": "docs_parallel_work_unstable_proof_trap", "label": "\u041b\u043e\u0432\u0443\u0448\u043a\u0430 4: \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u043c\u0438", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00ab\u0412\u0435\u0441\u044c \u043f\u0440\u043e\u0435\u043a\u0442 \u0437\u0435\u043b\u0451\u043d\u044b\u0439\u00bb \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0431\u044b\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0434\u0435\u0440\u0435\u0432\u043e \u043c\u0435\u043d\u044f\u043b\u043e\u0441\u044c \u043f\u043e\u0434 \u043d\u0435\u0439; \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u2014 \u0442\u043e\u0447\u0435\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u043e\u043d\u044b \u0441\u0432\u043e\u0438\u0445 \u043c\u043e\u0434\u0443\u043b\u0435\u0439, \u043e\u0431\u0449\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430 \u0441\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u0440\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438."}, {"id": "docs_parallel_work_unwarned_first_trap", "label": "\u041b\u043e\u0432\u0443\u0448\u043a\u0430 5: \u043d\u0435\u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0432\u044b\u0439", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u0435\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0439 \u0434\u043b\u044f \u043e\u0434\u0438\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430; \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u2014 \u0434\u043e\u0441\u043b\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u043e\u043c\u0443 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044e \u043f\u0440\u0430\u0432\u043a\u0443 \u043e \u0441\u043e\u0441\u0435\u0434\u0435 \u0438 \u0441\u043d\u044f\u0442\u044b\u0445 \u0433\u0435\u0439\u0442\u0430\u0445."}, {"id": "docs_parallel_work_launch_protocol", "label": "\u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_parallel_work_acceptance_protocol", "label": "\u041f\u0440\u0438\u0451\u043c\u043a\u0430 \u043f\u0440\u0438 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041e\u0431\u0440\u0430\u0442\u043d\u044b\u0439 \u043f\u043e\u0440\u044f\u0434\u043e\u043a (\u0441\u043a\u0435\u043f\u0442\u0438\u043a \u043f\u043e \u043f\u0435\u0440\u0432\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435, \u043f\u043e\u043a\u0430 \u0432\u0442\u043e\u0440\u0430\u044f \u0435\u0449\u0451 \u043f\u0438\u0448\u0435\u0442) \u0434\u0430\u0451\u0442 \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0439 \u0432\u0435\u0440\u0434\u0438\u043a\u0442, \u0442.\u043a. \u0441\u043a\u0435\u043f\u0442\u0438\u043a \u0441\u0432\u0435\u0440\u044f\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u044b\u0435 \u0441\u0443\u043c\u043c\u044b \u0444\u0430\u0439\u043b\u043e\u0432, \u0430 \u043e\u043d\u0438 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043f\u043e\u0434 \u043d\u0438\u043c."}, {"id": "docs_parallel_work_boundary_control", "label": "\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0433\u0440\u0430\u043d\u0438\u0446 \u2014 \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c, \u043d\u043e \u0441\u0432\u0435\u0440\u044f\u0442\u044c \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0440\u0430\u0432\u0438\u043b\u043e \u00ab\u0447\u0443\u0436\u043e\u0433\u043e \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0439\u00bb \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u043d\u0430 \u0447\u0435\u0441\u0442\u043d\u043e\u043c \u0441\u043b\u043e\u0432\u0435, \u043f\u043e\u043a\u0430 \u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442; \u043f\u0435\u0440\u0435\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0447\u0443\u0436\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u2014 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0439 \u0432\u0438\u0434 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043b\u0435\u0433\u043a\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c."}, {"id": "docs_parallel_work_order_and_composition", "label": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u0438 \u0441\u043e\u0441\u0442\u0430\u0432 \u0437\u0430\u0434\u0430\u0447", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0414\u043b\u0438\u043d\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u0441\u044f \u043f\u0435\u0440\u0432\u044b\u043c\u0438, \u0438\u043d\u0430\u0447\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u0441\u044f \u0440\u0430\u043d\u044c\u0448\u0435 \u0438 \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044c \u0441\u0435\u0440\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438; \u0434\u0432\u0430 \u043d\u043e\u0432\u044b\u0445 \u0441\u043b\u043e\u044f \u0440\u044f\u0434\u043e\u043c \u0443\u043f\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u0432 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438\u0442\u0441\u044f."}, {"id": "docs_parallel_work_machine_resource_limits", "label": "\u0420\u0435\u0441\u0443\u0440\u0441\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043c\u0430\u0448\u0438\u043d\u044b", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041d\u0430 \u0441\u043b\u0430\u0431\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u0435 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0431\u043e\u0440\u043a\u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0438\u0440\u0443\u044e\u0442 \u0437\u0430 \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440 \u0438 \u0443\u0445\u043e\u0434\u044f\u0442 \u0432 \u0441\u0432\u043e\u043f, \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0435\u0435 \u043e\u0434\u043d\u043e\u0439; \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440 \u2014 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438\u0442\u044c \u043f\u043e \u043f\u0430\u043c\u044f\u0442\u0438 \u0432 \u043f\u0438\u043a\u0435 \u0441\u0431\u043e\u0440\u043a\u0438, \u0430 \u043d\u0435 \u043f\u043e \u0447\u0438\u0441\u043b\u0443 \u044f\u0434\u0435\u0440."}, {"id": "docs_parallel_work_limits", "label": "\u041f\u0440\u0435\u0434\u0435\u043b\u044b \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": 