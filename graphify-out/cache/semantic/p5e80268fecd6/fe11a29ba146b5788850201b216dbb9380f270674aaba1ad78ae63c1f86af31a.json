{"nodes": [{"id": "docs_parallel_work", "label": "PARALLEL-WORK.md", "file_type": "document", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u044b \u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u043e: \u043f\u0443\u043d\u043a\u0442\u044b, \u0443\u0436\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u043e\u0439 Conductor (\u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0438 \u0440\u0430\u0443\u043d\u0434\u043e\u0432, \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c=\u0442\u0438\u0440\u044b, \u0438\u043d\u0432\u0435\u0440\u0441\u0438\u044f, \u00ab\u043e\u0442\u0447\u0451\u0442 \u2014 \u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u00bb), \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0435 \u0434\u0443\u0431\u043b\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c."}, {"id": "docs_parallel_work", "label": "PARALLEL-WORK.md", "file_type": "document", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_proof_loop", "label": "PROOF-LOOP.md", "file_type": "document", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "basalt_platform", "label": "\u041f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 Basalt (\u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438)", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_parallel_work_parallelism_norm", "label": "\u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u0438\u0437\u043c \u2014 \u043d\u043e\u0440\u043c\u0430, \u043d\u0435 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435: \u0441\u043b\u043e\u0439 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u0446\u0438\u043a\u043b \u043e\u043a\u043e\u043b\u043e \u043f\u044f\u0442\u0438 \u0447\u0430\u0441\u043e\u0432, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043a\u043e\u0434\u0430 \u2014 \u043c\u0435\u043d\u044c\u0448\u0435 \u0442\u0440\u0435\u0442\u0438; \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0432\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430 \u043c\u043e\u0433\u043b\u0430 \u0438\u0434\u0442\u0438 \u0440\u044f\u0434\u043e\u043c, \u043d\u043e \u043d\u0435 \u0448\u043b\u0430."}, {"id": "docs_parallel_work_area_separation", "label": "\u0420\u0430\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 (\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0448\u0430\u0433)", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0411\u0435\u0437 \u044f\u0432\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u0439 \u0438 \u0447\u0443\u0436\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u0431\u0430 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0434\u0435\u0440\u0435\u0432\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0438\u043c \u043e\u0434\u043d\u0438\u043c."}, {"id": "docs_parallel_work_whole_tree_gates_trap", "label": "\u041b\u043e\u0432\u0443\u0448\u043a\u0430 1: \u0433\u0435\u0439\u0442\u044b, \u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u0435 \u0446\u0435\u043b\u043e\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430", "file_type": "concept", "source_file": "docs/PARALLEL-WORK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0432\u0438\u0434\u0430 \u00ab\u0441\u043e\u0431\u0435\u0440\u0438 \u0432\u0435\u0441\u044c \u043f\u0440\u043e\u0435\u043a\u0442\u00bb \u043e\u043f\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430; \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0439 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u043e \u043b\u043e\u043c\u0430\u0435\u0442 \u0435\u0433\u043e \u0434\u043b\u044f \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b. \u0420\u0435\u0448\u0435\u043d\u0438\u0435: \u0438\u0437\u044a\u044f\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u0433\u0435\u0439\u0442\u044b \u0438\u0437 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u0437\u0430\u0434\u0430