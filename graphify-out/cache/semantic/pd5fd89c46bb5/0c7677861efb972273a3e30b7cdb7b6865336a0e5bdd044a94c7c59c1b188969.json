{"nodes": [{"id": "runtime_playbooks_distill_distillation_procedure", "label": "Distillation Procedure", "file_type": "document", "source_file": "runtime/playbooks/distill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_distill_lessons_inbox", "label": "Lessons inbox (lessons.md)", "file_type": "rationale", "source_file": "runtime/playbooks/distill.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture must be one cheap line at the moment of the failure; curation is deferred so the cost of remembering never competes with the work."}, {"id": "runtime_playbooks_distill_curated_store", "label": "Curated lesson store (lessons/ + INDEX.md)", "file_type": "rationale", "source_file": "runtime/playbooks/distill.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One file per lesson plus an index keeps lessons retrievable without costing session context; a new lesson restating a filed one updates that file instead of adding a duplicate."}, {"id": "runtime_playbooks_distill_graduation_rule", "label": "Graduate, file, or delete", "file_type": "rationale", "source_file": "runtime/playbooks/distill.md", "source_location": "steps 2-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The incident is the example, never the rule; a memory kept past the point it stopped being true is worse than no memory, so superseded lessons are deleted and the deletion is reported."}, {"id": "runtime_playbooks_distill_budget_measurement", "label": "Measure the target budget before writing", "file_type": "rationale", "source_file": "runtime/playbooks/distill.md", "source_location": "step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core.md has the tightest budget so a gra