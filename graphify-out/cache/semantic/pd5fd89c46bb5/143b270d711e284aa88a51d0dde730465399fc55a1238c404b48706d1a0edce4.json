{"nodes": [{"id": "runtime_playbooks_skeptic_skeptic_playbook", "label": "Skeptic Playbook", "file_type": "document", "source_file": "runtime/playbooks/skeptic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_skeptic_single_skeptic", "label": "Exactly one skeptic by default", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Invocation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skeptic exists only for the gap between a report and the artifact behind it - the one place your own gate cannot reach; re-checking your own proven edit costs a full context to re-derive evidence you already hold."}, {"id": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "label": "Verifier dispatch prompt", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Verifier dispatch prompt", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The implementer's report is re-typed as unverified claims and rationales never downgrade severity; format-forced output (verdict, finding with file:line, or a named check) plus a calibration floor so the skeptic does not manufacture findings."}, {"id": "runtime_playbooks_skeptic_cross_model_variant", "label": "Cross-model verifier variant", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Cross-model variant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A different model family does not share this model's blind spots; gated on a machine config file rather than playbook knowledge, probed with a trivial prompt under an outer timeout because a CLI can hang past its own limits, and its verdict is still a report, never evidence."}, {"id": "runtime_playbooks_skeptic_resolution_rules", "label": "Skeptic resolution rules", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Resolution rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cannot-verify verdict is resolved only by the controller running the exact named check; if that is impossible the claim cannot be DONE (anti-laundering), and a confirmed refutation is appended to the lessons ledger."}, {"id": "runtime_playbooks_skeptic_inversion_pass", "label": "Inversion pass", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Inversion pass", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listing what must be true and tagging each precondition PROVEN or ASSUMED converts confidence into a checkable list; an unverified assumption is the usual place a plausible claim is actually wrong."}, {"id": "runtime_playbooks_skeptic_inline_mode", "label": "Skeptic inline mode", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Inline mode", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in a separate message from the one that wrote the code, because verifying in the same message that implemented reproduces the author's blind spot; also serves review classification when /code-review is unavailable."}, {"id": "runtime_playbooks_skeptic_rigor_gradient", "label": "Rigor gradient", "file_type": "rationale", "source_file": "runtime/playbooks/skeptic.md", "source_location": "Rigor gradient", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification depth rises toward integration and merge - the last gate before the user is the strictest, never the most trusting."}], "edges": [{"source": "runtime_playbooks_skeptic_skeptic_playbook", "target": "runtime_playbooks_skeptic_single_skeptic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Invocation", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_skeptic_playbook", "target": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Verifier dispatch prompt", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "target": "runtime_playbooks_orchestration_dispatch_slot_whitelist", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Verifier dispatch prompt header", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_resolution_rules", "target": "runtime_core_completion_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Resolution rules", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_resolution_rules", "target": "runtime_core_circuit_breakers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Resolution rules failed rounds", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_resolution_rules", "target": "runtime_playbooks_distill_lessons_inbox", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Resolution rules lessons.md", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_inversion_pass", "target": "runtime_playbooks_debugging_two_hypotheses", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Inversion pass", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_rigor_gradient", "target": "runtime_playbooks_orchestration_integration_verification", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Rigor gradient", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_cross_model_variant", "target": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "Cross-model variant", "weight": 1.0}, {"source": "runtime_playbooks_skeptic_single_skeptic", "target": "runtime_core_orchestrator_role", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/skeptic.md", "source_location": "NOT a skeptic's job", "weight": 1.0}], "hyperedges": []}