{"nodes": [{"id": "adapters_antigravity_conductor_core_adapter", "label": "Conductor Core (Antigravity adapter)", "file_type": "document", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Antigravity has no hook mechanism to inject Conductor rules per turn, so the whole shared core body is shipped as a single standing rule file instead of being composed at runtime."}, {"id": "adapters_antigravity_conductor_core_always_on_activation", "label": "Always On activation (Antigravity Rules UI)", "file_type": "rationale", "source_file": "adapters/antigravity/conductor-core.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rule must be set to Always On in Customizations -> Rules because a per-request or model-decided rule would let the discipline gates be silently skipped on exactly the turns that need them."}], "edges": [{"source": "adapters_antigravity_conductor_core_adapter", "target": "adapters_antigravity_conductor_core_always_on_activation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adapters/antigravity/conductor-core.md", "source_location": "line 3", "weight": 1.0}, {"source": "adapters_antigravity_conductor_core_adapter", "target": "adapters_core_body_iron_laws", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adapters/antigravity/conductor-core.md", "source_location": "lines 5-11", "weight": 1.0}, {"source": "adapters_antigravity_conductor_core_adapter", "target": "adapters_core_body_completion_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adapters/antigravity/conductor-core.md", "source_location": "lines 19-34", "weight": 1.0}, {"source": "adapters_antigravity_conductor_core_adapter", "target": "adapters_core_