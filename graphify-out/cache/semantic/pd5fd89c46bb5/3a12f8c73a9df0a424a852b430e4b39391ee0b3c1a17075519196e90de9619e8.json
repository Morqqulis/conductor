{"nodes": [{"id": "runtime_playbooks_debugging", "label": "Debugging Playbook", "file_type": "document", "source_file": "runtime/playbooks/debugging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_debugging_reproduce_first", "label": "Reproduce Before Fixing", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "Sequence step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never fix what you cannot see fail: capture the exact repro command and output first; the attempt counter binds to that command. A failure first seen after your change must be reproduced on the pre-change state \u2014 failing there is pre-existing debt, reported separately. A/B v2 measured 12/12 conductor debug reps reproducing before editing vs 0/12 baseline."}, {"id": "runtime_playbooks_debugging_attempt_pre_registration", "label": "Attempt Pre-Registration", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "Sequence step 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fix attempt exists only as a todo entry 'attempt N: <H>' created BEFORE the edit; a failed run fails attempt N permanently \u2014 renaming it 'a refinement of attempt N' is the named violation. The counter resets only if the repro command changed AND the user confirmed a different bug. Blocks the silent edit-test thrash loop the 3-attempt breaker counts."}, {"id": "runtime_playbooks_debugging_falsification_ritual", "label": "Falsification Ritual", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "Sequence step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regression test must pass, then revert ONLY the fix and the test MUST fail (its own assertion, not a collection error), then restore and pass again \u2014 proving the test actually guards the fix. Mandatory at T2/T3, skipped at T1 (tier gating added after A/B v1 found over-ceremony on one-line T1 fixes). Manual revert path exists for untracked files so awkward tooling never skips the must-fail run."}], "edges": [{"source": "runtime_playbooks_debugging", "target": "runtime_playbooks_debugging_reproduce_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 1", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_playbooks_debugging_attempt_pre_registration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 4", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_playbooks_debugging_falsification_ritual", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 6", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_snippets_probes_dirty_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 6", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_core_completion_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 7", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_core_circuit_breakers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 5", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_playbooks_distill_lessons_inbox", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 3", "weight": 1.0}, {"source": "runtime_playbooks_debugging", "target": "runtime_playbooks_implementing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "Tripwires", "weight": 1.0}], "hyperedges": []}