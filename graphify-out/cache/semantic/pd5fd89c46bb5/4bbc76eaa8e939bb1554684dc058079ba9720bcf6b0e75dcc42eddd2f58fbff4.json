{"nodes": [{"id": "docs_superpowers_plans_2026_07_09_portability", "label": "Conductor Portability Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adapters_cursor_conductor_core", "label": "Cursor Conductor Core Digest", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_09_portability_three_layer_architecture", "label": "Three-Layer Portability Architecture (L1 text / L2 hooks / L3 git)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_09_portability_git_native_gate", "label": "Git-Native Commit Gate (Marker Protocol v2)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-commit checks the single-use marker, post-commit consumes it, so attempts that die later keep the marker alive; paths resolve via git rev-parse --git-path to survive worktrees and core.hooksPath. Later removed entirely as unnecessary (see HANDOFF)."}, {"id": "docs_superpowers_plans_2026_07_09_portability_cursor_adapter", "label": "Cursor Adapter (alwaysApply Rule + beforeShellExecution Gate)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "failClosed stays false: beforeShellExecution fires on every terminal command, so a crashed gate under failClosed would brick the whole terminal, not just commits; the git-native layer remains the enforcer."}, {"id": "docs_superpowers_plans_2026_07_09_portability_antigravity_adapter", "label": "Antigravity Adapter (Always-On Rule + PreToolUse Gate)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook reply schema pinned by binary forensics of agy.exe ({allow_tool, deny_reason}, exact fields only); the desktop Agent Manager did not invoke the global hook in live probes, so for Antigravity the git-native layer was the enforcement."}, {"id": "docs_superpowers_plans_2026_07_09_portability_self_installing_gate", "label": "Self-Installing Git Gate (Ensure-GitGate)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All shell gates install the git hooks on first commit contact \u2014 post-commit before pre-commit so a partial install never enables the check without its marker consumer; new repos born gated via init.templateDir."}, {"id": "docs_superpowers_plans_2026_07_09_portability_digest_first_strategy", "label": "Digest-First Adapter Strategy", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-09-portability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapters carry a digest (iron laws + completion gate + marker protocol), not full playbooks, until per-model live reps justify more; texts were tuned against one model family and may not transfer."}], "edges": [{"source": "docs_superpowers_plans_2026_07_09_portability_three_layer_architecture", "target": "docs_superpowers_plans_2026_07_09_portability", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_