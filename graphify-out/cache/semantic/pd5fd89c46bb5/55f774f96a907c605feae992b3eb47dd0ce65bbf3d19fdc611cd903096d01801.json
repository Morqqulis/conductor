{"nodes": [{"id": "readme", "label": "Conductor README (Russian)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "install_global", "label": "install-global.sh \u2014 Cursor/Antigravity/Codex Installer", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "install_project", "label": "install-project.sh \u2014 Per-Project Adapter Installer", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "uninstall", "label": "uninstall.sh \u2014 Symmetric Uninstaller", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tools_build_digests", "label": "tools/build-digests.sh \u2014 Digest Builder", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "qa_reports_baseline", "label": "qa/reports/baseline.md \u2014 Control-Group Baseline Report", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "qa_reports_baseline_values_file", "label": "qa/reports/baseline-values-file.md \u2014 56-Line Values File Snapshot", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "qa_reports_ab_report_v2", "label": "qa/reports/ab-report-v2.md \u2014 A/B Measurement v2", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_conductor_system", "label": "Conductor Discipline System", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes any AI agent classify the task before starting, prove the result before 'done' and before every git commit, and learn from its own failures via shared memory."}, {"id": "readme_values_file_prerequisite", "label": "Values File Is Mandatory", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The control run without Conductor passed 13/13 discipline trials because the global values file was present and spelled out the tested behavior; deleting it would silently remove all discipline, which is why uninstall.sh never deletes the global CLAUDE.md."}, {"id": "readme_commit_discipline", "label": "Commit Discipline (Evidence Before Commit)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit is a claim of readiness: a fresh evidence run before every git commit, its lines shown in the reply. Textual rule, not a mechanical lock \u2014 the marker git gate was removed as unnecessary."}, {"id": "readme_two_tier_memory", "label": "Two-Tier Lesson Memory (Inbox + Digested Store)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbox (one line per lesson, written by every AI on the machine) is separated from the digested store (one file per lesson plus a one-liner index), so growing memory is no longer lost memory."}, {"id": "readme_reply_language_token", "label": "Single Substituted Reply-Language Token", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model reasons in the language its instructions are written in; a Russian rule corpus dragged visible reasoning into Russian, so the corpus is English and only the phrase 'Answer in Russian' is substituted by installers. Lint guards the token; choice persists in ~/.claude/conductor/reply-language."}], "edges": [{"source": "readme_conductor_system", "target": "readme", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_values_file_prerequisite", "target": "readme", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_commit_discipline", "target": "readme", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_two_tier_memory", "target": "readme", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_reply_language_token", "target": "readme", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_en", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_az", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "deploy_global_claude", "relation": "references", "confidence": "EXTRACTED", "confi