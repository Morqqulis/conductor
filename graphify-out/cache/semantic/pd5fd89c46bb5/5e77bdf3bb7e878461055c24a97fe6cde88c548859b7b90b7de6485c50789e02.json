{"nodes": [{"id": "qa_reports_ab_report_v2_ab_report_v2", "label": "A/B Report v2 (v2.1 vs baseline, shipped English corpus)", "file_type": "document", "source_file": "qa/reports/ab-report-v2.md", "source_location": null, "source_url": null, "captured_at": "2026-08-15", "author": null, "contributor": null, "rationale": "27 reps per arm, 54 valid runs, both arms on live authorization so the credential-revocation problem that killed the v1 rig is excluded by construction; single judge, one rubric, verdicts decided by event order in the transcript rather than by the wording of the final answer."}, {"id": "qa_reports_ab_report_v2_parity_result", "label": "27/27 parity on discipline traps", "file_type": "rationale", "source_file": "qa/reports/ab-report-v2.md", "source_location": "1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The v1 finding reproduced at full n on the current model generation: a bare model carrying the shipped values file passes every discipline trap, so the core's value on short clean tasks is observability and wiring rather than fixing failures."}, {"id": "qa_reports_ab_report_v2_reproduce_first_contrast", "label": "Reproduce-first contrast (12/12 vs 0/12)", "file_type": "rationale", "source_file": "qa/reports/ab-report-v2.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Conductor debug rep reproduced the bug before the first edit while the baseline fixed first and proved after - which also passes the gate, but blind; the clearest measured behavioral difference between the arms."}, {"id": "qa_reports_ab_report_v2_ceremony_cost", "label": "Measured ceremony cost of the core", "file_type": "rationale", "source_file": "qa/reports/ab-report-v2.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Median 10 turns vs 8, $1.00 vs $0.77 per run, 80s vs 57s, with no subagents or plan mode anywhere - evidence that the v2.1 recalibration removed the v1 ceremonial overspend."}, {"id": "qa_reports_ab_report_v2_distribution_defect", "label": "Distribution defect: hardcoded module base path", "file_type": "rationale", "source_file": "qa/reports/ab-report-v2.md", "source_location": "3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core.md carried the author's machine path in the module manifest, so every playbook load failed on any other layout and the whole conductor arm was in fact measured in core-only mode; fixed by the __CONDUCTOR_DIR__ placeholder rendered at install, guarded in lint and doctor."}, {"id": "qa_reports_ab_report_v2_measurement_limits", "label": "What headless traps cannot measure", "file_type": "rationale", "source_file": "qa/reports/ab-report-v2.md", "source_location": "3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-session degradation, context compaction and work with other agents' reports are exactly where the core claims its value beyond observability, and short clean traps reproduce none of them - so the trimming decision waits on live journal data."}], "edges": [{"source": "qa_reports_ab_report_v2_ab_report_v2", "target": "qa_reports_ab_report_ab_report_v1", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "qa/reports/ab-report-v2.md", "source_location": "2-4 (v1 report, rec 7)", "weight": 1.0}, {"source": "qa_reports_ab_report_v2_ab_report_v2", "target": "qa_reports_ab_v2_baseline_evidence_baseline_arm", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "qa/reports/ab-report-v2.md", "source_location": "intro", "weight": 1.0}, {"source": "qa_reports_ab_report_v2_ab_report_v2", "target": "qa_reports_ab_v2_conductor_evidence_conductor_arm", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "qa/re