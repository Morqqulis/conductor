{"nodes": [{"id": "runtime_playbooks_debugging_debugging_playbook", "label": "Debugging Playbook", "file_type": "document", "source_file": "runtime/playbooks/debugging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_debugging_reproduce_first", "label": "Reproduce first", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never fix what you cannot see fail; the captured repro command is the anchor the attempt counter binds to, and an unreproducible bug is BLOCKED rather than speculatively patched."}, {"id": "runtime_playbooks_debugging_two_hypotheses", "label": "Two ranked falsifiable hypotheses", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first cause is where diagnosis goes to die, so at least two candidates are written down with the single check that best discriminates between them."}, {"id": "runtime_playbooks_debugging_prediction_before_check", "label": "Predict the check output before running it", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The surprise against a stated prediction is the evidence; instrumentation edits stay strictly observational so they cannot become an accidental fix."}, {"id": "runtime_playbooks_debugging_attempt_pre_registration", "label": "Fix attempt pre-registration", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "steps 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An attempt exists only as a todo entry created before the edit; renaming a failed attempt a refinement is banned by name, and the counter resets only if the repro command changed and the user confirmed a different bug."}, {"id": "runtime_playbooks_debugging_falsification_ritual", "label": "Falsification ritual", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pass / MUST-FAIL / pass proves the test actually guards the fix; a collection or import error is not a valid failure, and untracked files get a documented manual-revert path instead of a skipped ritual - skipped at T1 after v1 measured it wasting calls on one-line fixes."}, {"id": "runtime_playbooks_debugging_lessons_capture", "label": "Falsified hypothesis becomes a lesson", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One line appended to lessons.md (date, trigger, rule) makes the cheap capture path the default so learning does not depend on a later write-up."}, {"id": "runtime_playbooks_debugging_tripwires", "label": "Debugging output tripwires", "file_type": "rationale", "source_file": "runtime/playbooks/debugging.md", "source_location": "Tripwires", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed to the model's own tokens (should work now, while I am here) and decodes user pushback: stop guessing is a process signal, not pressure to move faster."}], "edges": [{"source": "runtime_playbooks_debugging_debugging_playbook", "target": "runtime_playbooks_debugging_reproduce_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 1", "weight": 1.0}, {"source": "runtime_playbooks_debugging_reproduce_first", "target": "runtime_playbooks_debugging_two_hypotheses", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "steps 1-2", "weight": 1.0}, {"source": "runtime_playbooks_debugging_two_hypotheses", "target": "runtime_playbooks_debugging_prediction_before_check", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "steps 2-3", "weight": 1.0}, {"source": "runtime_playbooks_debugging_prediction_before_check", "target": "runtime_playbooks_debugging_attempt_pre_registration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "steps 3-4", "weight": 1.0}, {"source": "runtime_playbooks_debugging_attempt_pre_registration", "target": "runtime_core_circuit_breakers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 5 counter rules", "weight": 1.0}, {"source": "runtime_playbooks_debugging_falsification_ritual", "target": "runtime_snippets_probes_dirty_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 6", "weight": 1.0}, {"source": "runtime_playbooks_debugging_falsification_ritual", "target": "runtime_core_completion_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/debugging.md", "source_location": "step 7", "weight": 1.0}, {"source": "runtime_playbooks_debugging_debugging_playbook", "target": "runtime_core_iron_laws", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "runtime/playbooks/debugging.md", "source_location": "Absolute", "weight": 1.0}, {"sour