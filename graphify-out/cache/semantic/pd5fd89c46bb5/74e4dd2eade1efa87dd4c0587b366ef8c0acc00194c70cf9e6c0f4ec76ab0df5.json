{"nodes": [{"id": "readme_az_document", "label": "Conductor README", "file_type": "document", "source_file": "README.az.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overview, operational requirements, installation, verification evidence, language, memory recovery, removal and source layout.", "_origin": "semantic"}, {"id": "readme_az_conductor", "label": "Conductor discipline system", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L7-L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The README describes task classification, proof before completion and commits, and task-relevant reuse of persisted lessons across Claude Code, Cursor, Antigravity and Codex.", "_origin": "semantic"}, {"id": "readme_az_methodology_layer", "label": "Methodology: core, playbooks and method dispatcher", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L17-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core iron laws and a predicted-outcome completion gate work with debugging, investigation, implementation, orchestration, skeptic and distillation playbooks; task essence selects the method.", "_origin": "semantic"}, {"id": "readme_az_change_scoped_verification", "label": "Proportional verification", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L18-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspection suffices for simple displayed wording; behavior changes require affected scenarios and applicable previous results can be reused.", "_origin": "semantic"}, {"id": "readme_az_memory_layer", "label": "Two-stage lesson memory", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L19-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every AI can cheaply append one line to the inbox; separate per-lesson files and an index support task-based contextual retrieval, with recency only breaking relevance ties.", "_origin": "semantic"}, {"id": "readme_az_inbox", "label": "Lessons inbox (~/.claude/conductor/lessons.md)", "file_type": "document", "source_file": "README.az.md", "source_location": "L19-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One line per captured lesson, shared by the agents on the machine.", "_origin": "semantic"}, {"id": "readme_az_curated", "label": "Curated lessons (~/.claude/conductor/lessons/)", "file_type": "document", "source_file": "README.az.md", "source_location": "L19-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One file per digested lesson plus an index; matching text must be read in context.", "_origin": "semantic"}, {"id": "readme_az_values_file_requirement", "label": "Mandatory global values file", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L21-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The documented discipline results depend on deploy/global-CLAUDE.md installed as ~/.claude/CLAUDE.md. Removing both duplicated rules and this file would invalidate that condition; uninstall preserves it.", "_origin": "semantic"}, {"id": "readme_az_baseline", "label": "qa/reports/baseline.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L27-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first control arm passed 13 discipline trials with the values file still installed; the README explicitly rejects interpreting this as a bare-model result.", "_origin": "semantic"}, {"id": "readme_az_baseline_values", "label": "qa/reports/baseline-values-file.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L37-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserves the 56-line trimmed Russian values-file conditions of the July measurement.", "_origin": "semantic"}, {"id": "readme_az_ab_report", "label": "qa/reports/ab-report-v2.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L46-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "August repetition used the full shipped English file: 27/27 at n=5 in both arms, reproduce-first in 12/12 debug repeats, +2 median turns. Long sessions, RTK/style/Graphify and the untriggered three-attempt breaker remain outside that evidence.", "_origin": "semantic"}, {"id": "readme_az_requirements", "label": "Installation prerequisites", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L57-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires Bash, Git and Python 3.10+; Windows uses Git for Windows/Git Bash from ordinary PowerShell. CI covers Windows/Linux; macOS is not separately verified. Claude Code is installed/authenticated and other IDE adapters are optional.", "_origin": "semantic"}, {"id": "readme_az_install", "label": "install.sh unified global installer", "file_type": "document", "source_file": "README.az.md", "source_location": "L92-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default all installs Claude Code and global adapters with companions; --scope selects claude/global/all. install-global.sh is internal compatibility, while Cursor activation remains manual.", "_origin": "semantic"}, {"id": "readme_az_bootstrap_ps", "label": "install.ps1 PowerShell bootstrap", "file_type": "document", "source_file": "README.az.md", "source_location": "L73-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads and executes official bootstrap source without a repository clone; prerequisites and execution policy are not silently changed, and language can be explicit.", "_origin": "semantic"}, {"id": "readme_az_bootstrap_sh", "label": "bootstrap.sh Bash bootstrap", "file_type": "document", "source_file": "README.az.md", "source_location": "L79-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The documented pipefail/curl pipeline downloads official source to temporary storage; users may inspect the downloaded script first.", "_origin": "semantic"}, {"id": "readme_az_install_snapshot", "label": "Installation snapshots and ownership checks", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L98-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial replacement warns and backs up; installs/<id> snapshots support manual recovery, not CLI rollback. Manual edits block reinstall, memory survives and ordinary installation must not run concurrently.", "_origin": "semantic"}, {"id": "readme_az_conductor_cli", "label": "conductor CLI: status, update and rollback", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L105-L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed in ~/.local/bin with conductor.cmd on Windows; fetches official main into a separate temporary directory, supports --check and --ref, and only updates registered components while preserving language and memory.", "_origin": "semantic"}, {"id": "readme_az_update_backup", "label": "Update backups and conditional rollback", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L128-L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "updates/ backups precede writes and failed checks restore files; later edits stop rollback. Backups survive uninstall, may contain private rules and are not auto-deleted. Concurrent update/rollback is locked and ordinary installation must stay separate.", "_origin": "semantic"}, {"id": "readme_az_companions", "label": "install-companions.sh (reference in README.az.md)", "file_type": "concept", "source_file": "README.az.md", "source_location": "L136-L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 4/5 installs superpowers, RTK and Graphify. --skip-companions skips all, --no-superpowers skips the plugin, --keep-superpowers is a compatibility no-op. Working tools are reused and OK/SKIP/FAIL/INCOMPLETE distinguish partial wiring without aborting Conductor.", "_origin": "semantic", "mentioned_label": "install-companions.sh", "referenced_file": "install-companions.sh"}, {"id": "readme_az_superpowers", "label": "superpowers workflow-skills plugin", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L141-L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official Claude plugin marketplace is preferred with obra/superpowers-marketplace fallback; the plugin is now installed because Conductor supplies discipline and superpowers supplies workflow skills.", "_origin": "semantic"}, {"id": "readme_az_rtk", "label": "RTK terminal-output compression", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L147-L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads an official release binary verified by SHA-256 without Rust/Cargo; rtk init -g --auto-patch wires the Claude hook, RTK.md and its import.", "_origin": "semantic"}, {"id": "readme_az_graphify", "label": "Graphify codebase knowledge graph", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L151-L154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs PyPI graphifyy in existing uv or isolated Python venv without system pip changes. Claude skill is connected; Codex skill installation is a separate printed command.", "_origin": "semantic"}, {"id": "readme_az_evidence_cli", "label": "conductor/evidence/cli.py", "file_type": "document", "source_file": "README.az.md", "source_location": "L179-L185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional explicit run/list/show/check stores real executions, full output and declared input snapshots, with separate histories for projects, clones and worktrees; it neither reuses the activity journal nor skips tests automatically.", "_origin": "semantic"}, {"id": "conductor_evidence_verification_spec", "label": "verification.json execution specification", "file_type": "document", "source_file": "README.az.md", "source_location": "L187-L203", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema version 1 declares argv, cwd, inputs, environment, external_state and timeout. The example runs check.py with src/check.py inputs, no declared environment keys, none_declared external state and a 60-second timeout.", "_origin": "semantic"}, {"id": "readme_az_evidence_match", "label": "MATCH applicability boundary", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L205-L210", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run always executes; show exposes metadata/full-output paths; check never runs a test. MATCH means observed conditions agree, while the agent must inspect coverage and output; unknown external state, links, unreadable inputs or lost environment key prevent reuse.", "_origin": "semantic"}, {"id": "readme_az_evidence_store", "label": "Local verification evidence storage", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L212-L219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored outside projects in LOCALAPPDATA/Conductor/evidence on Windows or XDG_STATE_HOME/conductor/evidence elsewhere, with absolute CONDUCTOR_EVIDENCE_HOME override. No upload/pruning, history survives reinstall/removal, secret output requires care, and 64 MiB truncation or corruption invalidates reuse.", "_origin": "semantic"}, {"id": "readme_az_commit_discipline", "label": "Commit discipline", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L221-L236", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspect impact, reuse only applicable inspected proof and match it to staged content. Full suites/builds need impact or an explicit project requirement; CI requirements remain in force and release builds are a separate delivery step.", "_origin": "semantic"}, {"id": "readme_az_marker_gate", "label": "Removed marker git gate", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L238-L242", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The textual proof rule remains after removal of the extra marker-file lock, which added no evidence and could break commits; installers clean its leftovers.", "_origin": "semantic"}, {"id": "readme_az_reply_language", "label": "Persisted reply language", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L244-L260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installer menus default to the prior choice in ~/.claude/conductor/reply-language, and --language supports noninteractive use. English instructions avoid unwanted Russian reasoning; replies and visible reasoning follow the chosen language via an explicit rule.", "_origin": "semantic"}, {"id": "readme_az_language_token_lint", "label": "Answer in Russian substitution token", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L262-L271", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repository masters must retain the substitution phrase guarded by lint; changing it breaks --language matching. Language overrides belong to installed/project-local settings.", "_origin": "semantic"}, {"id": "readme_az_project_language", "label": "Project-local language overrides", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L268-L271", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A project CLAUDE.md has its own immediately read language line; install-project.sh --repo ... --language overrides only that project's adapters and leaves the machine choice intact.", "_origin": "semantic"}, {"id": "readme_az_memory_transfer", "label": "Private memory transfer to another machine", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L273-L297", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restore the entire separate private repository into a new/empty directory before installing Conductor; project snapshots and Windows scheduling are explicit separate actions, and --keep-lessons is not a full repository backup.", "_origin": "semantic"}, {"id": "readme_az_restore_memory", "label": "tools/restore-memory.py (reference in README.az.md)", "file_type": "concept", "source_file": "README.az.md", "source_location": "L275-L279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserves committed history, lessons, archives, language and backup script; project restoration requires a separate command. Nonempty destinations are refused and cloning excludes uncommitted source data.", "_origin": "semantic", "mentioned_label": "tools/restore-memory.py", "referenced_file": "tools/restore-memory.py"}, {"id": "readme_az_schedule_memory", "label": "tools/schedule-memory-backup.ps1 (reference in README.az.md)", "file_type": "concept", "source_file": "README.az.md", "source_location": "L280-L282", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restores Windows scheduling separately, supports preview and never replaces an existing task.", "_origin": "semantic", "mentioned_label": "tools/schedule-memory-backup.ps1", "referenced_file": "tools/schedule-memory-backup.ps1"}, {"id": "readme_az_memory_recovery", "label": "docs/memory-recovery.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L282-L282", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linked recovery guide gives the complete-memory restore order and commands.", "_origin": "semantic"}, {"id": "readme_az_migrate_lessons", "label": "memory/migrate-lessons.sh", "file_type": "document", "source_file": "README.az.md", "source_location": "L284-L285", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed beside runtime so lesson maintenance works without a source checkout; the distillation playbook remains the procedure.", "_origin": "semantic"}, {"id": "readme_az_recall", "label": "memory/recall.py (reference in README.az.md)", "file_type": "concept", "source_file": "README.az.md", "source_location": "L286-L295", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absolute-path Python invocation with --query and --ledger searches inbox and full curated text including unindexed files. Additional queries express synonyms/languages; agent judges context. PARTIAL signals read/budget failures, no-match has no unrelated fallback and no-Python uses direct file search.", "_origin": "semantic", "mentioned_label": "memory/recall.py", "referenced_file": "runtime/memory/recall.py"}, {"id": "readme_az_recall_guide", "label": "memory/recall.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L286-L288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task-based retrieval guide; startup supplies locations, memory contents and maintenance policy stay unchanged, and unchanged retrieval need not repeat every message.", "_origin": "semantic"}, {"id": "readme_az_distill", "label": "playbooks/distill.md", "file_type": "document", "source_file": "README.az.md", "source_location": "L284-L285", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing lesson-maintenance procedure applies to the installed migration tool without requiring a checkout.", "_origin": "semantic"}, {"id": "readme_az_uninstall", "label": "uninstall.sh (reference in README.az.md)", "file_type": "concept", "source_file": "README.az.md", "source_location": "L299-L317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preview with --dry-run, preserve inbox/curated lessons to Desktop using --keep-lessons, and sweep legacy adapters/git locks under explicit --sweep-roots. Backups and foreign hooks survive; global CLAUDE.md and companions are preserved.", "_origin": "semantic", "mentioned_label": "uninstall.sh", "referenced_file": "uninstall.sh"}, {"id": "readme_az_repo_structure", "label": "Repository structure and source of truth", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L319-L336", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "runtime holds core/playbooks/contract/hooks, adapters contains the shared body and generated digests, deploy holds global CLAUDE, tools handles maintenance, qa holds lint/tests/reports and docs holds design history.", "_origin": "semantic"}, {"id": "readme_az_deploy", "label": "Digest build, lint and install cycle", "file_type": "rationale", "source_file": "README.az.md", "source_location": "L338-L340", "source_url": null, "captured_at": n