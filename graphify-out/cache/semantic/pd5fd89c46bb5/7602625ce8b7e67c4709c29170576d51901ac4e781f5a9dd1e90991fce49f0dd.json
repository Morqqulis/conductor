{"nodes": [{"id": "runtime_playbooks_methods", "label": "Method Selection Playbook", "file_type": "document", "source_file": "runtime/playbooks/methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_methods_dispatch_table", "label": "Essence-to-Method Dispatch Table", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name the task's dominant uncertainty (essence) in one line before designing the work; that uncertainty picks the method from an 11-row table (instrument-first, independent candidates, multi-angle sweep, pin-behavior-first, freshness ladder, etc.). An unannounced method choice cannot be examined or corrected; a named improvisation is reviewable, a silent one is not. Distilled from the author-model's own observed patterns (v1.10)."}, {"id": "runtime_playbooks_methods_control_group", "label": "Control-Group Method for Discipline Artifacts", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table row 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For artifacts meant to change agent behavior (rules, playbooks, injected prompts): measure failures WITHOUT it on real tasks, author every line against that proven failure list, adversarially refute, then re-run the SAME tasks WITH it. No subagents \u2014 the experiment measures the session's own pipeline."}, {"id": "runtime_playbooks_methods_freshness_ladder", "label": "Freshness Ladder", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For 'is remembered knowledge still true' questions: artifact forensics (binaries, schemas, live payloads) > official docs > blogs > memory. Memory alone is never evidence."}], "edges": [{"source": "runtime_playbooks_methods", "target": "runtime_playbooks_methods_dispatch_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_methods_control_group", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_methods_freshness_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_debugging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_investigating", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_implementing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Dispatch table", "weight": 1.0}, {"source": "runtime_playbooks_methods", "target": "runtime_playbooks_distill_lessons_inbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/methods.md", "source_location": "Tripwires", "weight": 1.0}], "hyperedges": []}