{"nodes": [{"id": "runtime_playbooks_methods_method_selection_playbook", "label": "Method Selection Playbook", "file_type": "document", "source_file": "runtime/playbooks/methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_methods_dispatch_rule", "label": "Essence to method dispatch rule", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "The dispatch rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dominant uncertainty picks the approach, and both are announced because an unannounced method choice cannot be examined or corrected; a named improvisation is reviewable, a silent one is not."}, {"id": "runtime_playbooks_methods_control_group", "label": "CONTROL GROUP method (discipline artifacts)", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table row 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a rule or injected prompt of an agent-discipline system: measure failures WITHOUT it first, author every line against that proven failure list, then re-run the same tasks WITH it - the no-guidance law that produced the baseline capture."}, {"id": "runtime_playbooks_methods_instrument_first", "label": "INSTRUMENT FIRST method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture the real payload before reasoning, then one discriminating experiment; the debugging playbook is this method instantiated."}, {"id": "runtime_playbooks_methods_independent_candidates", "label": "INDEPENDENT CANDIDATES method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Criteria are written before comparing so the winner is chosen, not rationalized; the winner takes grafts from the losers."}, {"id": "runtime_playbooks_methods_multi_angle_sweep", "label": "MULTI-ANGLE SWEEP method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop only when a full extra pass adds nothing new, because fixed counters undercount the tail of an unknown-size inventory."}, {"id": "runtime_playbooks_methods_pin_behavior_first", "label": "PIN BEHAVIOR FIRST method (refactor)", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unpinned refactor is an unproven rewrite, so current behavior is captured before anything is touched and re-checked after each small step."}, {"id": "runtime_playbooks_methods_freshness_ladder", "label": "FRESHNESS LADDER method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Artifact forensics beat official docs beat blogs beat memory; memory alone is never evidence about libraries, versions, tools or prices."}, {"id": "runtime_playbooks_methods_criteria_first", "label": "CRITERIA FIRST method (creative work)", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never grade your own work in the message that produced it - critique runs as a separate pass against the same externalized criteria."}, {"id": "runtime_playbooks_methods_smallest_reversible_step", "label": "SMALLEST REVERSIBLE STEP method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named undo first, verify between steps, stop at any surprise - the implementing playbook's absolutes as a method for dangerous change."}, {"id": "runtime_playbooks_methods_pilot_recipe_mechanize", "label": "PILOT to RECIPE to MECHANIZE method", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One case by hand extracts the recipe before scripting it wide, with per-item honest OK/SKIP reporting and verification by sampling artifacts."}, {"id": "runtime_playbooks_methods_probe_first", "label": "PROBE-FIRST method (undocumented systems)", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "dispatch table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build tolerant and instrumented and let live runs teach the real contract when no source of truth exists."}, {"id": "runtime_playbooks_methods_tripwires", "label": "Method tripwires (heaviness is a tier question)", "file_type": "rationale", "source_file": "runtime/playbooks/methods.md", "source_location": "Tripwires", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A method that feels too heavy is a tier question, never a licence to silently drop the method's spine (baseline measurement, second candidate, separate critique pass); a ledger lesson contradicting the method wins."}], "edges": [{"source": "runtime_playbooks_investigating_search_angles", "target": "runtime_playbooks_methods_multi_angle_sweep", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ru