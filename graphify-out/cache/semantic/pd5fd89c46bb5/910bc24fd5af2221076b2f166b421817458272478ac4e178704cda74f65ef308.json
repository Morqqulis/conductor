{"nodes": [{"id": "runtime_playbooks_orchestration", "label": "Orchestration Playbook", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_orchestration_cost_model", "label": "Context-Is-Rent Cost Model", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Cost model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything pasted into the main session is re-read every turn; a subagent reads 20 files and returns 10 lines. Stated explicitly so the WHEN rules generalize instead of being memorized. The size floor cuts both ways: dispatch costs a full context setup, so small work is never delegated."}, {"id": "runtime_playbooks_orchestration_constructed_context", "label": "Constructed Context (Closed Slot Whitelist)", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dispatch prompt contains exactly six slots (task, files, contracts, constraints, output contract, Conductor preset with the playbook body inline) \u2014 never inherited history. The preset slot spares subagents the Step 0 load rent; the skeptic prompt is the sanctioned instantiation of this whitelist, not an exception."}, {"id": "runtime_playbooks_orchestration_intersection_rule", "label": "Intersection Rule", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Integration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any file named by two or more agents from DIFFERENT angles is a coupling hotspot: read it yourself before accepting any conclusion about it. Part of the v1.1 connection-amplifiers wave; rigor peaks at integration, not dispatch."}, {"id": "runtime_playbooks_orchestration_worktree_isolation", "label": "Parallel Mutation Worktree Isolation", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN / PARALLEL MUTATION", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each parallel mutator works in its own git worktree created by the controller (dirty-tree probe first); neighbour files are read-only and needing one is BLOCKED, never a 'careful' shared edit. Whole-tree gates never go into a parallel dispatch \u2014 the controller runs them once after the tree stops moving. Worktrees isolate files, not configs or services."}, {"id": "runtime_playbooks_orchestration_status_routing", "label": "Controller Status Routing", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Routing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per returned status: DONE -> verify by artifact (the report is never the evidence), coverage map first; BLOCKED -> never re-dispatch the same prompt; NEEDS_CONTEXT -> attach the named context and dispatch a FRESH agent; DONE_WITH_CONCERNS -> each concern becomes a follow-up or recorded accepted risk."}], "edges": [{"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_orchestration_cost_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "Cost model", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_orchestration_constructed_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_orchestration_intersection_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "Integration", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_orchestration_worktree_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "PARALLEL MUTATION", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_orchestration_status_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "Routing", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_investigating_fan_out_thresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_snippets_probes_dirty_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_skeptic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "FLEET / Integration", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_playbooks_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "FLEET", "weight": 1.0}, {"source": "runtime_playbooks_orchestration", "target": "runtime_core_completion_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "Routing", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_constructed_context", "target": "runtime_subagent_contract_conductor_preset", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW slot 6", "weight": 1.0}], "hyperedges": [{"id": "conductor_subagent_dispatch_protocol", "label": "Subagent Dispatch Protocol", "nodes": ["runtime_playbooks_orchestration_constructed_context", "runtime_subagent_contract_conductor_preset", "runtime_subagent_contract_report_cap", "runtime_playbooks_skeptic_verifier_prompt"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "runtime/playbooks/orchestration.md"}]}