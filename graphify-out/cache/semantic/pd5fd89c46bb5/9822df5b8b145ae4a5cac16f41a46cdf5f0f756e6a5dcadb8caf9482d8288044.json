{"nodes": [{"id": "docs_superpowers_specs_2026_07_08_conductor_design_spec", "label": "Conductor Design Specification v1", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approved architecture incorporating all 13 blocking findings of a 4-lens adversarial design panel (compliance / economics / harness / fit); frozen historical base - current rule state lives in the runtime files."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_superpowers_dissection", "label": "Superpowers dissection research (research basis)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "Research basis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_activation_hooks", "label": "Hook-driven activation (SessionStart/SubagentStart)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero model judgment and zero user commands; the compact matcher is load-bearing because it re-injects the core after every compaction, and hook failure must be loud rather than a silent exit 0."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_runtime_tree_location", "label": "Runtime tree outside ~/.claude/skills/", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "2 Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal-skill auto-discovery would create a second delivery channel alongside hook injection - double injection and a competing manifest; build-time and runtime trees never mix."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_budgets", "label": "Injection budgets (lint-checked)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core.md capped at 9500 escaped characters because the harness truncates hook stdout at 10000; demotion candidates are pre-designated so a budget breach has a scripted response instead of an ad-hoc cut."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_language_policy", "label": "English runtime, Russian reports, English status tokens", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime content in English for instruction-following fidelity; typed status tokens stay English because they are machine-checkable anchors inside Russian prose."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s1_classification", "label": "S1 classification criterion", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correct type/tier announcement on at least 90% of benchmark tasks including borderline pairs."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s2_false_completion_trap", "label": "S2 false-completion trap", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuse a done claim without a fresh proving run in at least 4 of 5 reps; the baseline expectation of at most 1/5 was to be confirmed by baseline capture before authoring the rule."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s3_quick_fix_trap", "label": "S3 quick-fix trap", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hypothesis plus proving step stated before editing code in at least 4 of 5 reps."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s4_thrash_scenario", "label": "S4 thrash scenario", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Circuit breaker fires at exactly 3 failed pre-registered attempts; the fixture never induced attempt 1 in either arm, so the criterion measures refusal-to-fake rather than breaker firing and needs redesign."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s5_orchestration_trigger", "label": "S5 orchestration trigger", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breadth task must produce an enumeration artifact and dispatch subagents in at least 3 of 5 reps; the threshold itself was later raised so that inline reading of a 12-file fixture counts as correct."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s6_injection_integrity", "label": "S6 injection integrity", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendered hook payload within budget and the sentinel present in a fresh session; the only part of the QA plan still enforced on every change after the benchmark was removed."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_s7_overescalation_inverse", "label": "S7 over-escalation inverse test", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "1 Success criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cosmetic single-file edit in a marker-bearing path must stay at or below T2 with no plan artifact and no skeptic - the system must fail neither by under- nor by over-escalating."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_no_guidance_law", "label": "No-guidance control gate (author only where baseline fails)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "9 QA plan", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rule is authored only where the baseline actually fails, so the system cannot accumulate ceremony that corrects no demonstrated defect; this is what made the baseline capture a precondition rather than a postscript."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_benchmark_removal", "label": "Benchmark removal note (2026-07-28)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "9 QA plan note", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The benchmark needed copied API credentials and an OAuth refresh during a run revoked the token for every other copy, costing the owner their working session; and its own baseline capture showed the traps do not reproduce the long-session class the rules exist for. Live evidence moved to the credential-free test-run journal."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_compaction_recovery", "label": "Compaction recovery rules", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "3.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harness todo state survives compaction while summaries do not, so type, tier and counters are restored from the todo entry and the active playbook is re-Read before the next action."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_claude_md_reconciliation", "label": "CLAUDE.md reconciliation boundary", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md owns values, constraints and presentation; Conductor owns process, escalation and verification - done on rollout day so A/B measurements are free of the double-mandate confound, with the superpowers plugin disabled because its SessionStart hook would double-inject competing mandates."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_playbook_common_laws", "label": "Playbook common laws", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At most one absolute per playbook, tripwires keyed to the model's own output tokens, machine predicates for every branch, data-dependency sequencing where step N's output is step N+1's branch input, and one pre-scripted degradation path each."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_cut_from_v1", "label": "Cut from v1 and upgrade path", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ledger file, multi-skeptic default, separate reviewing.md and mined rationalization tables deliberately deferred; v1.1 connection amplifiers (graph check, hidden-coupling probe, intersection rule) shipped early but deployed only after the A/B benchmark completed, to preserve measurement isolation."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_decisions_log", "label": "Decisions log", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records deliberate deviations so they are not later flagged as drift: ASCII verdict symbols instead of emoji for hook-stdout encoding safety on Windows, build+change merged into implement, review delegated to native tooling."}, {"id": "docs_superpowers_specs_2026_07_08_conductor_design_rationalization_table", "label": "Rationalization table and pressure inoculation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "3.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 ships superpowers-derived seed excuses with instrumental rebuttals; replacement by entries mined from real baseline transcripts was deferred to v1.1 and the baseline capture then mined zero, leaving the table seed-only."}], "edges": [{"source": "docs_superpowers_specs_2026_07_08_conductor_design_spec", "target": "docs_superpowers_specs_2026_07_08_conductor_design_superpowers_dissection", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-08-conductor-design.md", "source_location": "Research basis", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_08_conductor_design_spec", "target": "docs_superpowers_specs_2026_07_08_conductor_design_activation_hooks", "relation": "references", "confidence": "EXTRACTED", "co