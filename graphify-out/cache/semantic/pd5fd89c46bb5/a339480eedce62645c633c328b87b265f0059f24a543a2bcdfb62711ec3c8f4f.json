{"nodes": [{"id": "runtime_core_conductor_core", "label": "Conductor Core (core.md)", "file_type": "document", "source_file": "runtime/core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_core_sentinel", "label": "Core sentinel CONDUCTOR-CORE-v1-7f3a", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed marker string inside the injected core so a transcript can be machine-checked for whether the hook actually fired."}, {"id": "runtime_core_iron_laws", "label": "Iron Laws", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "IRON LAWS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated as capability denials rather than shoulds so satisfying the letter cannot violate the spirit; exactly one escape valve (a user message in this conversation about this task) keeps standing instructions and inferred urgency from becoming overrides."}, {"id": "runtime_core_step_0", "label": "Step 0 first-action protocol", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "STEP 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classification runs before any response including clarifying questions, because module choice and gate depend on it; the todo entry is the durable state that survives compaction."}, {"id": "runtime_core_classification", "label": "Task classification (debug/implement/investigate/review/trivial)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "CLASSIFY", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic priority debug > review > implement > investigate so process-failure symptoms outrank surface verbs; observable signals only."}, {"id": "runtime_core_trivial_classification", "label": "Trivial turn definition", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "TRIVIAL", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anti-ceremony contract: a turn that neither mutates files nor claims a status skips steps 1-4; trivial is retroactively voidable, not a permission."}, {"id": "runtime_core_tripwire", "label": "Mutation tripwire (announce late)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "TRIPWIRE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any file mutation or status claim without an announcement forces Step 0 retroactively, closing the loophole of declaring work trivial after the fact."}, {"id": "runtime_core_risk_tiers", "label": "Risk tiers T1/T2/T3", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "TIER", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mechanical signals only (never feels-risky) so tiering is testable; T2 is the residual tier so nothing falls through unclassified."}, {"id": "runtime_core_domain_markers", "label": "Domain markers (auth, payment, prod, ...)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "TIER markers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word-boundary matched in the request or the touched paths; a demonstrably cosmetic marker may hold T1 only with a voiced false-positive declaration, because silent overrides were observed defeating the rule 3/3 in the v1 benchmark."}, {"id": "runtime_core_re_tier", "label": "Re-tier on facts (upward only)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "RE-TIER", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projections set only the starting tier; each escalation trigger is bound to an observable moment (6th file, git diff --stat over 300 LOC, caller probe over 5) so escalation cannot be argued away."}, {"id": "runtime_core_completion_gate", "label": "Completion gate", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "COMPLETION GATE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence expires at the message boundary and any later mutation invalidates it, so the proving run must be the last action before the claim; missing verification forces BLOCKED instead of being downgraded to a concern."}, {"id": "runtime_core_claim_evidence_table", "label": "Claim to evidence table", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "claim/evidence table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs each claim with the only sufficient evidence plus an explicit NOT-sufficient column; agent completed X requires the inspected diff, never the agent's report."}, {"id": "runtime_core_typed_status_tokens", "label": "Typed status tokens", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "COMPLETION GATE step 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "English tokens kept inside Russian reports because they are machine-checkable anchors; BLOCKED and NEEDS_CONTEXT are first-class completed turns so honest failure is not penalized."}, {"id": "runtime_core_unverified_label", "label": "UNVERIFIED label rule", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "UNVERIFIED LABEL", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any factual claim about code, tools or APIs without in-session evidence carries the label in place, including an assertion used to refuse a suggestion - fabricated persuasion is the same defect class as fabricated success."}, {"id": "runtime_core_circuit_breakers", "label": "Circuit breakers (3 attempts / 2 skeptic rounds)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "Counters", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three failed pre-registered attempts means the frame is wrong rather than the hypothesis; counters live in the todo entry so they survive compaction."}, {"id": "runtime_core_orchestrator_role", "label": "Orchestrator role (main session)", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "EFFORT AND ROLE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegate only what is independent AND sizeable; never spawn an agent to re-check work you can verify yourself, since it can only re-derive evidence you already hold."}, {"id": "runtime_core_long_runs", "label": "Long runs discipline", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "LONG RUNS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remaining context is never a reason to stop or propose a fresh session; every progress claim is audited against a tool result from this session before being written."}, {"id": "runtime_core_pressure_inoculation", "label": "Pressure and degradation inoculation", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "PRESSURE AND DEGRADATION", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time pressure, authority and sunk cost raise the stakes so gates apply more strictly; four common excuses are named as one skipped gate to make the rationalization recognizable in the model's own output."}, {"id": "runtime_core_module_manifest", "label": "Module manifest", "file_type": "rationale", "source_file": "runtime/core.md", "source_location": "MODULES", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One line per module: trigger condition plus temptation symptom, zero procedure; the base directory is a render-time placeholder after a hardcoded author path broke playbook loading on every other machine."}], "edges": [{"source": "runtime_core_conductor_core", "target": "runtime_core_iron_laws", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "IRON LAWS", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_step_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "STEP 0", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_sentinel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "line 1", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_completion_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "COMPLETION GATE", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_module_manifest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "MODULES", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_long_runs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "LONG RUNS", "weight": 1.0}, {"source": "runtime_core_conductor_core", "target": "runtime_core_pressure_inoculation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/core.md", "source_location": "PRESSURE AND DEGRADATION