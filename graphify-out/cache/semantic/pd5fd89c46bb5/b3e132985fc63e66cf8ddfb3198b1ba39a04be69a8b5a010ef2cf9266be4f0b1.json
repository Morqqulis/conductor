{"nodes": [{"id": "docs_mentor_notes", "label": "Mentor's Letter (MENTOR-NOTES)", "file_type": "document", "source_file": "docs/MENTOR-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Fable", "contributor": null}, {"id": "docs_mentor_notes_three_failure_roots", "label": "Three Roots of Model Failure", "file_type": "rationale", "source_file": "docs/MENTOR-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Fable", "contributor": null, "rationale": "Models fail on context management, not intelligence: lost intent, false recognition, unverified success. Everything Conductor builds is protection against these three."}, {"id": "docs_mentor_notes_rule_only_after_proven_failure", "label": "Rules Only Where Failure Is Proven", "file_type": "rationale", "source_file": "docs/MENTOR-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Fable", "contributor": null, "rationale": "A bare model with a minimal values file passed 13/13 discipline traps; the heavy 9-section ritual likely hindered more than helped. Rules are written only against a concrete observed failure, never 'just in case'."}, {"id": "docs_mentor_notes_silent_failure_lesson", "label": "Silent Failure Is Worse Than Loud", "file_type": "rationale", "source_file": "docs/MENTOR-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Fable", "contributor": null, "rationale": "A hook died on bash-eaten slashes while the installer reported success \u2014 the system was dead and looked alive. Verify systems by their traces (transcripts), not by their own reports."}, {"id": "docs_mentor_notes_change_cycle", "label": "Conductor Change Cycle (Observe Failure -> Mechanical Rule -> Lint -> Live Test)", "file_type": "concept", "source_file": "docs/MENTOR-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Fable", "contributor": null}], "edges": [{"sourc