{"nodes": [{"id": "runtime_playbooks_implementing_implementing_playbook", "label": "Implementing Playbook", "file_type": "document", "source_file": "runtime/playbooks/implementing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_implementing_read_before_write", "label": "Read before write", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Absolute", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No edit before the touched region has been read in this session - the playbook's single absolute, aimed at the temptation to code from priors."}, {"id": "runtime_playbooks_implementing_named_undo", "label": "Named undo before first edit (T2+)", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Absolute", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iron Law 3 gates the truly irreversible; naming the restore command makes the reversible provably reversible before any mutation."}, {"id": "runtime_playbooks_implementing_restraint", "label": "Restraint (scope is a contract)", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Restraint", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A floor on invention, never on quality: validate at system boundaries and trust internal guarantees inside them, because error handling for a case that cannot occur is dead code that reads as diligence."}, {"id": "runtime_playbooks_implementing_decomposition_triage", "label": "Decomposition triage", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More than one independently deliverable outcome means separate units, each with its own Step 0 record and its own counters."}, {"id": "runtime_playbooks_implementing_existing_surface_branch", "label": "Existing surface branch", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 2A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branches on an observable predicate (do the named files exist - Glob them, do not assume) rather than on the model's impression of the task."}, {"id": "runtime_playbooks_implementing_new_surface_branch", "label": "New surface branch (contracts first)", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 2B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At T3 two distinct approaches with trade-offs are drafted before choosing, because the first idea is a candidate, not a decision; types and boundaries are written before implementation."}, {"id": "runtime_playbooks_implementing_scope_fence", "label": "Scope fence (pre-declared adjacent edits)", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 2A.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An adjacent edit is legal only if declared before it is made; the report merely aggregates declarations, so the undeclared edit is the violation rather than the adjacency itself."}, {"id": "runtime_playbooks_implementing_assumptions_ledger", "label": "Assumptions ledger for vague requests", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State defaults and implement against them instead of asking a question per item; only correctness-critical unknowns earn one grouped question block."}, {"id": "runtime_playbooks_implementing_tests", "label": "Test-first when a runner exists", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TDD is conditional on a discovered runner, not dogma; a check is only as trustworthy as its measured preconditions, and a partial fake leaks actions onto real state."}, {"id": "runtime_playbooks_implementing_cleanup_sweep", "label": "Cleanup sweep for deletes/renames/moves", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Cleanup sweep", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old name is a debt until a search returns zero unexplained hits; side artifacts (registrations, caches, DB columns, env vars, docs) are named and resolved because deleting a thing without its wiring is half a deletion."}, {"id": "runtime_playbooks_implementing_library_api_claims", "label": "Library/API claims need current docs", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Library/API claims", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory is not evidence: verify against context7 or the installed package's source, else label the claim unverified in place."}], "edges": [{"source": "runtime_playbooks_implementing_implementing_playbook", "target": "runtime_playbooks_implementing_read_before_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/implementing.md", "source_location": "Absolute", "weight": 1.0}, {"source": "runtime_playbooks_implementing_implementing_playbook", "target": "runtime_playbooks_implementing_named_undo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/implementing.md", "source_