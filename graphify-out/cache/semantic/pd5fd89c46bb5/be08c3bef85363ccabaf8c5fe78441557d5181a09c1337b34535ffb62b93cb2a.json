{"nodes": [{"id": "runtime_playbooks_implementing", "label": "Implementing Playbook", "file_type": "document", "source_file": "runtime/playbooks/implementing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_implementing_named_undo", "label": "Named Undo Before First Edit", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Absolute", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At T2+ the first mutating edit requires a NAMED undo (restore command or backup) recorded in the todo or message; no named undo -> no edit. Iron Law 3 gates the truly irreversible; this makes the reversible provably reversible."}, {"id": "runtime_playbooks_implementing_scope_fence", "label": "Restraint and Scope Fence", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Restraint / Step 2A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scope is a contract: deliver what was asked, whole, without added features, refactors or hypothetical-future abstractions; validate at system boundaries and trust internal code inside them. An adjacent edit is legal only if declared BEFORE making it \u2014 the undeclared adjacent edit is the violation, and 'while I'm here' is the tripwire. A floor on invention, never on quality."}, {"id": "runtime_playbooks_implementing_cleanup_sweep", "label": "Cleanup Sweep on Delete/Rename/Move", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Cleanup sweep", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old name is a debt until proven settled: search code, configs, docs and generated copies until zero unexplained hits, pasting the count as evidence; name and resolve orphaned side artifacts (hook/route/DI registrations, caches, DB objects, env vars). Deleting a thing without its wiring is half a deletion."}, {"id": "runtime_playbooks_implementing_remove_only_proof", "label": "Remove-Only Proof for New Guards", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new guard earns trust at T2+ by deleting or disarming the protected thing \u2014 the guard MUST go red; restore \u2014 green; both outputs pasted. A red-green pair told in words is unproven. Companion rule: a green is worth only what it EXERCISED \u2014 read the count, interleaving and bytes, not the exit code."}, {"id": "runtime_playbooks_implementing_library_api_claims", "label": "Library/API Claims Verification", "file_type": "rationale", "source_file": "runtime/playbooks/implementing.md", "source_location": "Library/API claims", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any claim about library/framework/API behavior requires verification against CURRENT docs (context7 when available, else installed package source/types) \u2014 memory is not evidence; unverifiable claims carry 'from memory, unverified' in place."}], "edges": [{"source": "runtime_playbooks_implementing", "target": "runtime_playbooks_implementing_named_undo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/implementing.md", "source_location": "Absolute", "weight": 1.0}, {"source": "runtime_playbooks_implementing", "target": "runtime_playbooks_implementing_scope_fence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/implementing.md", "source_location": "Restraint", "weight": 1.0}, {"source": "runtime_playbooks_implementing", "target": "runtime_playbooks_implementing_cleanup_sweep", "relation": "references", "confidence": "E