{"nodes": [{"id": "runtime_playbooks_orchestration_orchestration_playbook", "label": "Orchestration Playbook", "file_type": "document", "source_file": "runtime/playbooks/orchestration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_orchestration_cost_model", "label": "Context is rent (cost model)", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Cost model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything pasted into the main session is re-read every turn, so a subagent that reads 20 files and returns 10 lines is the saving; stating the model makes the delegation rules generalize instead of being memorized."}, {"id": "runtime_playbooks_orchestration_when_proxies", "label": "WHEN machine proxies for dispatch", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machine proxies never judgment: thresholds live in investigating.md and the two files move together; doubt about independence resolves toward dispatch."}, {"id": "runtime_playbooks_orchestration_size_floor", "label": "Delegation size floor", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "SIZE FLOOR", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatch costs a full context setup, so small subtasks are not delegated; both over- and under-delegation are failures, added after v1 measured ceremonial fan-out on a 12-file fixture."}, {"id": "runtime_playbooks_orchestration_async_controller", "label": "Async controller (never idle)", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "ASYNC", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A controller blocked on the slowest agent has converted parallel work back into serial work; long-lived agents reuse a warm context instead of re-paying setup."}, {"id": "runtime_playbooks_orchestration_fleet_shape", "label": "Fleet size and shape", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "FLEET", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Size equals independent angles times verification votes, never a favorite number; unknown-size discovery loops until a full round finds nothing new, and experiments measuring the session's own pipeline are never parallelized because the agents change the thing being measured."}, {"id": "runtime_playbooks_orchestration_dispatch_slot_whitelist", "label": "Closed dispatch slot whitelist", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly six slots and never inherited history, so the agent's context is constructed rather than leaked; the report file lives outside the repo tree so litter does not trip the dirty-tree probe."}, {"id": "runtime_playbooks_orchestration_conductor_preset_slot", "label": "Conductor preset slot", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW slot 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playbook body pasted inline so the subagent skips Step 0 load and does not re-pay the load rent."}, {"id": "runtime_playbooks_orchestration_routing_table", "label": "Status routing table", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Routing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DONE is verified by artifact because the report is never the evidence; BLOCKED is never re-dispatched with the same prompt, and NEEDS_CONTEXT gets a fresh agent with the named context attached."}, {"id": "runtime_playbooks_orchestration_intersection_rule", "label": "Intersection rule (coupling hotspot)", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Integration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file named by two or more agents from different angles is read by the controller itself before any conclusion about it is accepted - a connection amplifier shipped early in v1.1."}, {"id": "runtime_playbooks_orchestration_integration_verification", "label": "Integration verification purpose", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "Integration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rigor peaks at integration, not at dispatch; a fresh-context verifier is for work you did not watch being done, not a second opinion on an edit you already proved."}, {"id": "runtime_playbooks_orchestration_worktree_isolation", "label": "Worktree isolation for parallel mutation", "file_type": "rationale", "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worktrees isolate files but not configs or live services, so shared mutable state is still excluded from parallelization."}], "edges": [{"source": "runtime_playbooks_methods_independent_candidates", "target": "runtime_playbooks_orchestration_fleet_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "FLEET judge panel", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_orchestration_playbook", "target": "runtime_playbooks_orchestration_cost_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "Cost model", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_when_proxies", "target": "runtime_playbooks_investigating_fan_out_threshold", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_when_proxies", "target": "runtime_playbooks_orchestration_size_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_worktree_isolation", "target": "runtime_snippets_probes_dirty_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "WHEN", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_dispatch_slot_whitelist", "target": "runtime_playbooks_orchestration_conductor_preset_slot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW slot 6", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_dispatch_slot_whitelist", "target": "runtime_playbooks_skeptic_verifier_dispatch_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md", "source_location": "HOW skeptic dispatch", "weight": 1.0}, {"source": "runtime_playbooks_orchestration_dispatch_slot_whitelist", "target": "runtime_playbooks_orchestration_cost_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "runtime/playbooks/orchestration.md", "source_location