"confidence_score": 0.95, "source_file": "runtime/playbooks/orchestration.md", "source_location": "SIZE FLOOR", "weight": 1.0}], "hyperedges": [{"id": "delegation_lifecycle", "label": "Delegation lifecycle (dispatch to integration)", "nodes": ["runtime_playbooks_orchestration_when_proxies", "runtime_playbooks_orchestration_dispatch_slot_whitelist", "runtime_playbooks_orchestration_conductor_preset_slot", "runtime_playbooks_orchestration_routing_table", "runtime_playbooks_orchestration_integration_verification", "runtime_subagent_contract_subagent_contract", "runtime_playbooks_skeptic_verifier_dispatch_prompt"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/orchestration.md"}]}