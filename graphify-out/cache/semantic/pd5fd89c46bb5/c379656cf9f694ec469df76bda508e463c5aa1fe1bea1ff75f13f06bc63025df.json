{"nodes": [{"id": "runtime_subagent_contract", "label": "Conductor Subagent Contract", "file_type": "document", "source_file": "runtime/subagent-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_subagent_contract_conductor_preset", "label": "Conductor Preset Slot", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the dispatch prompt contains 'Conductor preset:', the playbook body is already inline \u2014 the subagent must not re-classify or Read playbook files, so it never re-pays the load rent. Deliberately redundant with hook injection: hooks can be stripped, prompts can be malformed, either channel alone suffices."}, {"id": "runtime_subagent_contract_report_cap", "label": "Report Cap and Report File", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final subagent message <= 15 lines; details go to a report file OUTSIDE the repo tree (litter in the working tree would trip the dirty-tree probe). The report carries a coverage map: each dispatch requirement -> where satisfied or MISSING."}], "edges": [{"source": "runtime_subagent_contract", "target": "runtime_subagent_contract_conductor_preset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 5", "weight": 1.0}, {"source": "runtime_subagent_contract", "target": "runtime_subagent_contract_report_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 3", "weight": 1.0}, {"source": "runtime_subagent_contract", "target": "runtime_core_typed_status_tok