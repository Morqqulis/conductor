{"nodes": [{"id": "runtime_subagent_contract_subagent_contract", "label": "Conductor Subagent Contract", "file_type": "document", "source_file": "runtime/subagent-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_subagent_contract_status_rule", "label": "Subagent typed status rule", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Honest failure is legitimized explicitly (you will not be penalized for BLOCKED) because the only failure mode that actually costs the controller is fabricated success."}, {"id": "runtime_subagent_contract_evidence_rule", "label": "Subagent evidence rule", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything edited after the proving run un-proves it; missing verification is never a concern, it forces BLOCKED."}, {"id": "runtime_subagent_contract_report_cap", "label": "Report cap and out-of-tree report file", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final message capped at 15 lines with detail pushed to a named file outside the repo tree, so returns stay cheap in the controller's context and litter does not trip the dirty-tree probe."}, {"id": "runtime_subagent_contract_no_nested_orchestration", "label": "No nested orchestration", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One level of delegation only; a subagent needing fan-out returns NEEDS_CONTEXT with the recommended split so the controller keeps the topology visible."}, {"id": "runtime_subagent_contract_conductor_preset", "label": "Conductor preset slot honoring", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the playbook body is already inline the subagent skips Step 0 load, so delegation does not re-pay the load rent; the contract channel is redundant with the dispatch-prompt slot by design because either alone can be stripped."}, {"id": "runtime_subagent_contract_human_gates", "label": "Subagent human gate default-deny", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A subagent cannot ask the user, so any step needing approval stops as BLOCKED naming the exact pending action rather than proceeding non-interactively."}, {"id": "runtime_subagent_contract_scope_rule", "label": "Subagent scope fence", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rules 7-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adjacent problems are findings, not edits; instructions are applied at exactly the scope they name, and scope-changing ambiguity returns BLOCKED naming both readings."}, {"id": "runtime_subagent_contract_findings_coverage", "label": "Findings coverage rule", "file_type": "rationale", "source_file": "runtime/subagent-contract.md", "source_location": "rule 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report every finding with confidence and severity - filtering belongs to the dispatcher, so the agent optimizes for coverage instead of pre-judging relevance."}], "edges": [{"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_status_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 1", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_evidence_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 2", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_report_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 3", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_no_nested_orchestration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 4", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_conductor_preset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 5", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_human_gates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rule 6", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_scope_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/subagent-contract.md", "source_location": "rules 7-8", "weight": 1.0}, {"source": "runtime_subagent_contract_subagent_contract", "target": "runtime_subagent_contract_finding