{"nodes": [{"id": "docs_proof_loop", "label": "Proof Loop Doc", "file_type": "document", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_proof_loop_green_without_proof_is_red", "label": "Green Without Proof = Red", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A green run only asserts 'what ran, ran'; trust the proof that the check checked what it claims \u2014 zero-executed-checks 'success', early exits, literal counts, and same-named checks all count as failures."}, {"id": "docs_proof_loop_remove_only_refutation", "label": "Remove-Only Refutation Step", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a check goes green, delete the guard it verifies: the check must go red, and green again once restored. Without the pair the check may pass for unrelated reasons; in practice this step catches more than test authoring itself."}, {"id": "docs_proof_loop_reverse_experiment_baseline", "label": "Reverse Experiment on the Pre-Change State", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When something fails after a change, first ask whether it was broken before you: reproduce on a clean copy of the original state. Minutes of cost against weeks of searching in the wrong place."}, {"id": "docs_proof_loop_integrity_guards_always_run", "label": "Integrity Guards Run on Every Task", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behavior checks depend only on their module and may be skipped; integrity guards read the whole project and break on any edit, so 'touched modules' for them is the whole project. Measured cost: 0.111s of 146s."}, {"id": "docs_proof_loop_three_roles", "label": "Executor / Skeptic / Owner / Human Role Split", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The executor cannot see own blind spots; the fresh-context skeptic refutes the report; the owner personally reruns proving commands; the human decides the irreversible and product questions. The executor's report is never evidence."}, {"id": "docs_proof_loop_false_greens_catalog", "label": "Catalog of False Greens", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_proof_loop_proportionality", "label": "Proportionality: Ritual Level Follows Risk", "file_type": "concept", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mechanism applied identically to everything dies \u2014 people bypass it; sensitive areas are defined by a word list, the level rises mid-work on evidence and is never lowered by the executor."}, {"id": "docs_proof_loop_report_is_not_proof", "label": "The Executor's Report Is Not Proof", "file_type": "rationale", "source_file": "docs/PROOF-LOOP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skeptic receives the report as unverified claims; the owner reruns commands personally \u2014 this is where 'green only on the author's machine' is caught."}], "edges": [{"source": "docs_proof_loop_green_without_proof_is_red", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_remove_only_refutation", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_reverse_experiment_baseline", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_integrity_guards_always_run", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_three_roles", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_false_greens_catalog", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_proportionality", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop_report_is_not_proof", "target": "docs_proof_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PROOF-LOOP.md", "source_location": null, "weight": 1.0}, {"source": "docs_proof_loop", "target": "docs_parallel_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1