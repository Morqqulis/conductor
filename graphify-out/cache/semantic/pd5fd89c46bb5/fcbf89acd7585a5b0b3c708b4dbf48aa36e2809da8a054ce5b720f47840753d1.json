{"nodes": [{"id": "runtime_playbooks_investigating", "label": "Investigating Playbook", "file_type": "document", "source_file": "runtime/playbooks/investigating.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_playbooks_investigating_graph_check", "label": "Graph Check (graphify Step 0)", "file_type": "rationale", "source_file": "runtime/playbooks/investigating.md", "source_location": "Sequence step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/ exists in the project root, query the knowledge graph first \u2014 connections there are data, not guesses; its answers seed the enumeration list. Mechanical predicate (directory existence), added in the v1.1 'connection amplifiers' wave."}, {"id": "runtime_playbooks_investigating_enumeration_first", "label": "Enumeration Artifact First", "file_type": "rationale", "source_file": "runtime/playbooks/investigating.md", "source_location": "Sequence step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always build the candidate list (files plus four search angles: by-name, by-content, by-caller, by-config) before reading, and state its length \u2014 the list is the branch input for the fan-out decision. Files read outside the list must be added to it first, re-evaluating the threshold on every addition."}, {"id": "runtime_playbooks_investigating_fan_out_thresholds", "label": "Fan-Out Thresholds (>20 files / >1500 lines)", "file_type": "rationale", "source_file": "runtime/playbooks/investigating.md", "source_location": "Sequence step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over 20 candidate files or a MEASURED 1500+ lines -> load orchestration.md and fan out; at or under, batched inline reads are the normal path, not an evasion. Raised from the spec's >8-file trigger after A/B v1 S5 showed effort-estimate rationalizations ('tiny files, serial is faster') escaping the count-only rule; binding to a measured quantity closed every reframe (v1.3.1 3/3 PASS)."}], "edges": [{"source": "runtime_playbooks_investigating", "target": "runtime_playbooks_investigating_graph_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "step 0", "weight": 1.0}, {"source": "runtime_playbooks_investigating", "target": "runtime_playbooks_investigating_enumeration_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "step 1", "weight": 1.0}, {"source": "runtime_playbooks_investigating", "target": "runtime_playbooks_investigating_fan_out_thresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "step 1", "weight": 1.0}, {"source": "runtime_playbooks_investigating", "target": "runtime_playbooks_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "Absolute", "weight": 1.0}, {"source": "runtime_playbooks_investigating", "target": "runtime_snippets_probes_hidden_coupling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "step 1", "weight": 1.0}, {"source": "runtime_playbooks_investigating", "target": "runtime_playbooks_orchestration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "runtime/playbooks/investigating.md", "source_location": "step 1", "weight": 1.0}], "hyperedges": []}