{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"C:/Users/Dee/.claude/conductor/hooks/session-start.sh\"", "timeout": 10 },
          { "type": "command", "command": "bash \"C:/Users/Dee/.claude/conductor/hooks/lessons-inject.sh\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"C:/Users/Dee/.claude/conductor/hooks/subagent-start.sh\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"C:/Users/Dee/.claude/conductor/hooks/user-prompt.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
