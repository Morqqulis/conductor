#!/bin/sh
# conductor gate: merge consumer (this line is the sentinel installers/detectors grep).
# Consumes the single-use verification marker after a successful MERGE - git runs
# post-merge here, NOT post-commit (measured: a gated --no-ff merge left the marker
# untouched until this hook existed). Fast-forward merges also land here: consuming the
# marker for them is the strict direction - may force a re-prove, never a false allow.
MARKER=$(git rev-parse --path-format=absolute --git-path conductor-verified 2>/dev/null) ||
    MARKER="$(git rev-parse --absolute-git-dir 2>/dev/null)/conductor-verified"
case "$MARKER" in
    /conductor-verified) exit 0 ;;
esac
[ -f "$MARKER" ] && rm -f "$MARKER"

CHAINED=$(git rev-parse --path-format=absolute --git-path hooks/post-merge.pre-conductor 2>/dev/null)
if [ -n "$CHAINED" ] && [ -f "$CHAINED" ]; then
    if [ -x "$CHAINED" ]; then
        "$CHAINED" "$@"
    else
        sh "$CHAINED" "$@"
    fi
fi
exit 0
