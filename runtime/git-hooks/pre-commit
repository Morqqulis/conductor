#!/bin/sh
# Conductor commit gate (git-native layer). Blocks any `git commit` in this repository
# unless a fresh (<=30 min) single-use verification marker exists. The companion
# post-commit hook consumes the marker after a SUCCESSFUL commit, so attempts that die
# later (commit-msg hook, empty commit, aborted editor) do not burn the proving run.
# Harness-agnostic: enforced by git itself for AI agents and humans alike.
# Known limits (see docs/superpowers/plans/2026-07-09-portability.md): --no-verify and a
# per-command -c core.hooksPath override skip pre-commit hooks entirely (harness-level
# gates deny both textually); merge/rebase/cherry-pick/revert commit without pre-commit.
# Paths come from `git rev-parse --git-path`, which resolves correctly inside linked
# worktrees (marker is per-worktree, hooks live in the common dir) and under hooksPath.
MARKER=$(git rev-parse --path-format=absolute --git-path conductor-verified 2>/dev/null) ||
    MARKER="$(git rev-parse --absolute-git-dir 2>/dev/null)/conductor-verified"
case "$MARKER" in
    /conductor-verified) exit 0 ;;   # path resolution failed: not a repo, let git decide
esac

deny() {
    echo "conductor gate: $1" >&2
    echo "Run the proving command (read its full output), then create the marker and retry:" >&2
    echo "  bash:       touch \"$MARKER\"" >&2
    echo "  PowerShell: New-Item -Force -ItemType File \"$MARKER\" | Out-Null" >&2
    exit 1
}

[ -f "$MARKER" ] || deny "no verification marker."
fresh=$(find "$MARKER" -mmin -30 2>&1) || deny "cannot check marker age (find -mmin unsupported here?): $fresh"
[ -n "$fresh" ] || deny "verification marker is stale (older than 30 minutes)."

# A pre-existing hook displaced by install-git-gate.ps1 runs after the gate. Direct
# execution preserves its shebang (bash/python hooks keep working); sh is the fallback
# for files without the exec bit (fresh Windows checkouts).
CHAINED=$(git rev-parse --path-format=absolute --git-path hooks/pre-commit.pre-conductor 2>/dev/null)
if [ -n "$CHAINED" ] && [ -f "$CHAINED" ]; then
    if [ -x "$CHAINED" ]; then
        "$CHAINED" "$@" || exit $?
    else
        sh "$CHAINED" "$@" || exit $?
    fi
fi
exit 0
