#!/bin/sh
# Conductor commit gate (git-native layer, merge path). git runs this before creating a
# MERGE commit - without it, `git merge` was a documented bypass of the pre-commit gate.
# Same protocol: a fresh (<=30 min) single-use marker must exist; the POST-MERGE hook
# consumes it (post-commit never fires on merges - measured). Chaining and limits mirror
# pre-commit; see docs/superpowers/plans/2026-07-09-portability.md.
MARKER=$(git rev-parse --path-format=absolute --git-path conductor-verified 2>/dev/null) ||
    MARKER="$(git rev-parse --absolute-git-dir 2>/dev/null)/conductor-verified"
case "$MARKER" in
    /conductor-verified) exit 0 ;;   # path resolution failed: not a repo, let git decide
esac

deny() {
    echo "conductor gate: $1" >&2
    echo "A denied merge leaves MERGE_HEAD behind: run 'git merge --abort' first." >&2
    echo "Then run the proving command (read its full output), create the marker, retry:" >&2
    echo "  bash:       touch \"$MARKER\"" >&2
    echo "  PowerShell: New-Item -Force -ItemType File \"$MARKER\" | Out-Null" >&2
    exit 1
}

[ -f "$MARKER" ] || deny "no verification marker (merge commits are gated too)."
fresh=$(find "$MARKER" -mmin -30 2>&1) || deny "cannot check marker age (find -mmin unsupported here?): $fresh"
[ -n "$fresh" ] || deny "verification marker is stale (older than 30 minutes)."

CHAINED=$(git rev-parse --path-format=absolute --git-path hooks/pre-merge-commit.pre-conductor 2>/dev/null)
if [ -n "$CHAINED" ] && [ -f "$CHAINED" ]; then
    if [ -x "$CHAINED" ]; then
        "$CHAINED" "$@" || exit $?
    else
        sh "$CHAINED" "$@" || exit $?
    fi
fi
exit 0
